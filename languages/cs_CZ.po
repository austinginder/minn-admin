#: includes/class-minn-admin-rest.php:10437
msgid "WordPress only stores layout width changes for someone who can post unfiltered HTML, which this account cannot on this site."
msgstr "WordPress ukládá změny šířky rozložení pouze někomu, kdo může vkládat nefiltrované HTML, což tento účet na tomto webu nemůže."

#: includes/class-minn-admin-rest.php:10685
msgid "That palette or typeset is not part of the active theme."
msgstr "Tato paleta nebo sada písem není součástí aktivní šablony."

#: includes/class-minn-admin-rest.php:10688
msgid "WordPress only stores a palette or typeset for someone who can post unfiltered HTML, which this account cannot on this site."
msgstr "WordPress ukládá paletu nebo sadu písem pouze někomu, kdo může vkládat nefiltrované HTML, což tento účet na tomto webu nemůže."

