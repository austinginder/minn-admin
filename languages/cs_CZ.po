#: includes/class-minn-admin-db.php:2005
msgid "Database hygiene"
msgstr "Hygiena databáze"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:2011
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s kontrola úložiště vyžaduje pozornost"
msgstr[1] "%s kontroly úložiště vyžadují pozornost"
msgstr[2] "%s kontrol úložiště vyžaduje pozornost"

#: includes/class-minn-admin-db.php:2019
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Osiřelé řádky, indexy i enginy vypadají v pořádku"

#: includes/class-minn-admin-db.php:2086
msgid "Tables without a primary key"
msgstr "Tabulky bez primárního klíče"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2092
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Tyto tabulky nemají primární klíč, což rozbíjí replikaci po řádcích a mate nástroje pro zálohy a migrace: %s"

#: includes/class-minn-admin-db.php:2095
msgid "Every table has a primary key."
msgstr "Každá tabulka má primární klíč."

#: includes/class-minn-admin-db.php:2107
msgid "Storage engine"
msgstr "Úložný engine"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:2113
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Tyto tabulky nepoužívají InnoDB, proto jim chybí zamykání řádků a obnova po pádu: %s"

#: includes/class-minn-admin-db.php:2116
msgid "Every table uses InnoDB."
msgstr "Každá tabulka používá InnoDB."

#: includes/class-minn-admin-db.php:2118
msgid "Convert a table"
msgstr "Převést tabulku"

#: includes/class-minn-admin-db.php:2120
msgid "Back up first. Converting locks the table while it runs."
msgstr "Nejprve zálohujte. Převod tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:2139
msgid "Reclaimable space"
msgstr "Získatelné místo"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:2146
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Jen %1$s drží %2$s volného místa ve vlastním souboru. Optimalizace tabulku přepíše a místo vrátí disku."

#: includes/class-minn-admin-db.php:2150
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Žádná tabulka nedrží významné množství získatelného místa."

#: includes/class-minn-admin-db.php:2152
msgid "Optimise tables"
msgstr "Optimalizovat tabulky"

#: includes/class-minn-admin-db.php:2154
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Nejprve zálohujte. Optimalizace každou tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:2172
msgid "Post meta lookup index"
msgstr "Index vyhledávání post meta"

#: includes/class-minn-admin-db.php:2175
msgid "Present"
msgstr "Přítomen"

#: includes/class-minn-admin-db.php:2177
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Kombinovaný index post_id a meta_key je přítomen, proto vyhledávání meta zůstává rychlé."

#: includes/class-minn-admin-db.php:2178
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Vyhledávání podle příspěvku a meta klíče padá na dva samostatné indexy. Na webech s hodně meta (WooCommerce, pluginy událostí a rezervací) je kombinovaný index velká a málo riziková výhra."

#: includes/class-minn-admin-db.php:2180
msgid "Add the index"
msgstr "Přidat index"

#: includes/class-minn-admin-db.php:2182
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Nejprve zálohujte. Přidání indexu tabulku krátce zamkne."

#: includes/class-minn-admin-db.php:2226
msgid "Auto-increment headroom"
msgstr "Rezerva auto-increment"

#: includes/class-minn-admin-db.php:2228
msgid "Healthy"
msgstr "Zdravé"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2233
