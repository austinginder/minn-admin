msgid "This post type was changed somewhere else after you opened it. Close it and open it again to see the change."
msgstr "Tento typ příspěvku byl změněn jinde poté, co jste ho otevřeli. Zavřete ho a otevřete znovu, ať změnu uvidíte."

#: includes/class-minn-admin-cpt.php:745
msgid "This taxonomy was changed somewhere else after you opened it. Close it and open it again to see the change."
msgstr "Tato taxonomie byla změněna jinde poté, co jste ji otevřeli. Zavřete ji a otevřete znovu, ať změnu uvidíte."

#: includes/class-minn-admin-cpt.php:840
msgid "Slug is required: lowercase letters, numbers, dashes or underscores, 20 characters max."
msgstr "Název v URL je povinný: malá písmena, číslice, pomlčky nebo podtržítka, nejvýše 20 znaků."

#. translators: %s: the slug
#: includes/class-minn-admin-cpt.php:846
#: includes/class-minn-admin-cpt.php:1350
msgid "“%s” is a name WordPress reserves; pick another slug."
msgstr "“%s” je název, který si vyhrazuje WordPress; zvolte jiný identifikátor."

#: includes/class-minn-admin-cpt.php:852
#: includes/class-minn-admin-cpt.php:964
#: includes/class-minn-admin-cpt.php:1354
#: includes/class-minn-admin-cpt.php:1428
msgid "Singular and plural labels are required."
msgstr "Jednotné i množné názvy jsou povinné."

#: includes/class-minn-admin-cpt.php:875
msgid "No such post type."
msgstr "Takový typ příspěvku neexistuje."

#: includes/class-minn-admin-cpt.php:884
msgid "This post type is registered in code and can only be changed there."
msgstr "Tento typ příspěvku je registrován v kódu a změnit ho lze jen tam."

#. translators: 1: a post type feature, such as excerpt, 2: a post type's name.
#: includes/class-minn-admin-cpt.php:1014
msgid "%1$s is turned on for %2$s outside the settings Minn Admin edits (by the theme, a plugin or a custom supports field), so it cannot be turned off here."
msgstr "Funkce %1$s je pro %2$s zapnutá mimo nastavení, která Minn Admin upravuje (šablonou, pluginem nebo vlastním polem supports), takže ji tady nelze vypnout."

#. translators: 1: a post type feature, such as excerpt, 2: a post type's name.
#: includes/class-minn-admin-cpt.php:1024
msgid "%1$s is already on in the settings of %2$s, but the theme or a plugin turns it off, so it cannot be turned on here."
msgstr "Funkce %1$s je v nastavení typu příspěvku %2$s už zapnutá, ale šablona nebo plugin ji vypíná, takže ji tady nelze zapnout."

#. translators: 1: a taxonomy's name, 2: a post type's name.
#: includes/class-minn-admin-cpt.php:1091
msgid "%1$s is attached to %2$s by the theme or a plugin, not in either one’s settings, so it cannot be detached here."
msgstr "Taxonomie %1$s je k typu příspěvku %2$s připojená šablonou nebo pluginem, ne v nastavení žádného z nich, takže ji tady nelze odpojit."

#. translators: 1: a taxonomy's name, 2: a post type's name.
#: includes/class-minn-admin-cpt.php:1112
msgid "%1$s is already attached to %2$s in their settings, but the theme or a plugin detaches it, so it cannot be attached here."
msgstr "Taxonomie %1$s je k typu příspěvku %2$s v jejich nastavení už připojená, ale šablona nebo plugin ji odpojuje, takže ji tady nelze připojit."

#. translators: 1: a taxonomy's name, 2: a post type's name.
#: includes/class-minn-admin-cpt.php:1123
msgid "JetEngine keeps a post type’s taxonomies in each taxonomy’s settings, and %1$s is not one you can edit here, so it cannot be attached to %2$s."
msgstr "JetEngine ukládá taxonomie typu příspěvku v nastavení každé taxonomie a %1$s není taxonomie, kterou tu můžete upravit, takže ji nelze připojit k typu příspěvku %2$s."

#. translators: 1: a taxonomy's name, 2: a post type's name, 3: a plugin's name, such as Custom Post Type UI.
#: includes/class-minn-admin-cpt.php:1143
msgid "%1$s is attached to %2$s in %3$s, which this site keeps to people with that plugin’s own access."
msgstr "Taxonomie %1$s je k typu příspěvku %2$s připojená v pluginu %3$s, který tento web zpřístupňuje jen lidem s vlastním oprávněním tohoto pluginu."

#: includes/class-minn-admin-cpt.php:1226
#: includes/class-minn-admin-cpt.php:1472
msgid "ACF definition not found."
msgstr "Definice ACF nebyla nalezena."

#: includes/class-minn-admin-cpt.php:1245
msgid "This post type is registered in code and can only be removed there."
msgstr "Tento typ příspěvku je registrován v kódu a odstranit ho lze jen tam."

#: includes/class-minn-admin-cpt.php:1248
msgid "Definition removed; existing content stays in the database."
msgstr "Definice odstraněna; existující obsah zůstává v databázi."

#: includes/class-minn-admin-cpt.php:1344
msgid "Slug is required: lowercase letters, numbers, dashes or underscores, 32 characters max."
msgstr "Název v URL je povinný: malá písmena, číslice, pomlčky nebo podtržítka, nejvýše 32 znaků."

#: includes/class-minn-admin-cpt.php:1379
msgid "No such taxonomy."
msgstr "Taková taxonomie neexistuje."

#: includes/class-minn-admin-cpt.php:1388
msgid "This taxonomy is registered in code and can only be changed there."
msgstr "Tato taxonomie je registrována v kódu a změnit ji lze jen tam."

#: includes/class-minn-admin-cpt.php:1491
msgid "This taxonomy is registered in code and can only be removed there."
msgstr "Tato taxonomie je registrována v kódu a odstranit ji lze jen tam."

#: includes/class-minn-admin-cpt.php:1494
msgid "Definition removed; existing terms stay in the database."
msgstr "Definice odstraněna; existující termíny zůstávají v databázi."

#: includes/class-minn-admin-cpt.php:1536
#: includes/class-minn-admin-cpt.php:1566
msgid "ACF could not save the taxonomy."
msgstr "ACF nemohl taxonomii uložit."

#: includes/class-minn-admin-cpt.php:1659
#: includes/class-minn-admin-cpt.php:1692
msgid "ACF could not save the post type."
msgstr "ACF nemohl typ příspěvku uložit."

#: includes/class-minn-admin-cpt.php:1777
#: includes/class-minn-admin-cpt.php:1780
msgid "JetEngine could not save the post type."
msgstr "JetEngine nemohl uložit typ příspěvku."

#: includes/class-minn-admin-cpt.php:1844
#: includes/class-minn-admin-cpt.php:1847
msgid "JetEngine could not save the taxonomy."
msgstr "JetEngine nemohl uložit taxonomii."

#: includes/class-minn-admin-cpt.php:1855
msgid "JetEngine definition not found."
msgstr "Definice JetEngine nebyla nalezena."

#: includes/class-minn-admin-cpt.php:1862
#: includes/class-minn-admin-cpt.php:1864
msgid "JetEngine could not remove the definition."
msgstr "JetEngine nemohl definici odstranit."

#: includes/class-minn-admin-db.php:1927
#: includes/class-minn-admin-db.php:1956
#: includes/class-minn-admin-db.php:2118
msgid "Unknown table."
msgstr "Neznámá tabulka."

#: includes/class-minn-admin-db.php:1931
#: includes/class-minn-admin-db.php:1960
msgid "Could not read the table structure."
msgstr "Strukturu tabulky se nepodařilo načíst."

#: includes/class-minn-admin-db.php:1999
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Tento sloupec obsahuje hesla nebo tokeny, takže ho nelze prohledávat."

#: includes/class-minn-admin-db.php:2022
msgid "This site holds too many credentials for Minn to check a value search against, so values cannot be searched here."
msgstr "Na tomto webu je příliš mnoho přihlašovacích údajů, než aby Minn mohl ověřit hledání hodnoty, takže hodnoty zde nelze hledat."

#: includes/class-minn-admin-db.php:2124
msgid "This table has no usable primary key."
msgstr "Tato tabulka nemá použitelný primární klíč."

#: includes/class-minn-admin-db.php:2134
msgid "Row not found."
msgstr "Řádek nebyl nalezen."

#: includes/class-minn-admin-db.php:2201
msgid "Not checked"
msgstr "Nezkontrolováno"

#: includes/class-minn-admin-db.php:2202
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Tato tabulka je na levné spočítání příliš velká, proto ji Minn neskenuje. Ke kontrole spusťte příkaz níže."

#: includes/class-minn-admin-db.php:2276
msgid "Database hygiene"
msgstr "Hygiena databáze"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:2282
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s kontrola úložiště vyžaduje pozornost"
msgstr[1] "%s kontroly úložiště vyžadují pozornost"
msgstr[2] "%s kontrol úložiště vyžaduje pozornost"

#: includes/class-minn-admin-db.php:2290
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Osiřelé řádky, indexy i enginy vypadají v pořádku"

#: includes/class-minn-admin-db.php:2357
msgid "Tables without a primary key"
msgstr "Tabulky bez primárního klíče"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2364
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Tyto tabulky nemají primární klíč, což rozbíjí replikaci po řádcích a mate nástroje pro zálohy a migrace: %s"

#: includes/class-minn-admin-db.php:2367
msgid "Every table has a primary key."
msgstr "Každá tabulka má primární klíč."

#: includes/class-minn-admin-db.php:2381
msgid "Storage engine"
msgstr "Úložný engine"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:2388
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Tyto tabulky nepoužívají InnoDB, proto jim chybí zamykání řádků a obnova po pádu: %s"

#: includes/class-minn-admin-db.php:2391
msgid "Every table uses InnoDB."
msgstr "Každá tabulka používá InnoDB."

#: includes/class-minn-admin-db.php:2393
msgid "Convert a table"
msgstr "Převést tabulku"

#: includes/class-minn-admin-db.php:2395
msgid "Back up first. Converting locks the table while it runs."
msgstr "Nejprve zálohujte. Převod tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:2414
msgid "Reclaimable space"
msgstr "Získatelné místo"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:2421
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Jen %1$s drží %2$s volného místa ve vlastním souboru. Optimalizace tabulku přepíše a místo vrátí disku."

#: includes/class-minn-admin-db.php:2425
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Žádná tabulka nedrží významné množství získatelného místa."

#: includes/class-minn-admin-db.php:2427
msgid "Optimise tables"
msgstr "Optimalizovat tabulky"

#: includes/class-minn-admin-db.php:2429
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Nejprve zálohujte. Optimalizace každou tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:2447
msgid "Post meta lookup index"
msgstr "Index vyhledávání post meta"

#: includes/class-minn-admin-db.php:2450
msgid "Present"
msgstr "Přítomen"

#: includes/class-minn-admin-db.php:2452
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Kombinovaný index post_id a meta_key je přítomen, proto vyhledávání meta zůstává rychlé."

#: includes/class-minn-admin-db.php:2453
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Vyhledávání podle příspěvku a meta klíče padá na dva samostatné indexy. Na webech s hodně meta (WooCommerce, pluginy událostí a rezervací) je kombinovaný index velká a málo riziková výhra."

#: includes/class-minn-admin-db.php:2455
msgid "Add the index"
msgstr "Přidat index"

#: includes/class-minn-admin-db.php:2457
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Nejprve zálohujte. Přidání indexu tabulku krátce zamkne."

#: includes/class-minn-admin-db.php:2501
msgid "Auto-increment headroom"
msgstr "Rezerva auto-increment"

#: includes/class-minn-admin-db.php:2503
msgid "Healthy"
msgstr "Zdravé"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2509
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Tyto tabulky jsou do 20 procent od největšího id, které typ sloupce unese. Po dosažení stropu se nové řádky přestanou zapisovat: %s"

#: includes/class-minn-admin-db.php:2512
msgid "No table is close to exhausting its id column."
msgstr "Žádná tabulka se neblíží vyčerpání sloupce id."

#: includes/class-minn-admin-db.php:2520
msgid "Orphaned post meta"
msgstr "Osiřelá post meta"

#: includes/class-minn-admin-db.php:2523
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Tyto meta řádky patří k příspěvkům, které už neexistují. Jsou zátěží v každém dotazu na post meta."

#: includes/class-minn-admin-db.php:2524
msgid "Every meta row belongs to a post that still exists."
msgstr "Každý meta řádek patří k příspěvku, který stále existuje."

#: includes/class-minn-admin-db.php:2526
#: includes/class-minn-admin-db.php:2544
#: includes/class-minn-admin-db.php:2562
msgid "Delete them"
msgstr "Smazat je"

#: includes/class-minn-admin-db.php:2528
#: includes/class-minn-admin-db.php:2546
#: includes/class-minn-admin-db.php:2564
msgid "Back up first. This permanently deletes rows."
msgstr "Nejprve zálohujte. Tím se řádky trvale smažou."

#: includes/class-minn-admin-db.php:2538
msgid "Orphaned user meta"
msgstr "Osiřelá user meta"

#: includes/class-minn-admin-db.php:2541
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Tyto meta řádky patří k uživatelům, kteří už neexistují, obvykle po pluginu, který účty smazal přímo."

#: includes/class-minn-admin-db.php:2542
msgid "Every meta row belongs to a user who still exists."
msgstr "Každý meta řádek patří k uživateli, který stále existuje."

#: includes/class-minn-admin-db.php:2556
msgid "Orphaned term relationships"
msgstr "Osiřelé vztahy termínů"

#: includes/class-minn-admin-db.php:2559
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Tyto řádky propojují obsah s rubrikami nebo štítky, které už neexistují."

#: includes/class-minn-admin-db.php:2560
msgid "Every relationship points at a term that still exists."
msgstr "Každý vztah ukazuje na termín, který stále existuje."

#: includes/class-minn-admin-db.php:2574
msgid "Stored revisions"
msgstr "Uložené starší verze"

#: includes/class-minn-admin-db.php:2577
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Starší verze jsou záchranná síť editoru, proto je velký počet normální a není chyba. Mazat je má smysl, jen když tabulka příspěvků přerostla."

#: includes/class-minn-admin-db.php:2578
msgid "No revisions are stored."
msgstr "Nejsou uloženy žádné starší verze."

#: includes/class-minn-admin-db.php:2580
msgid "Delete all revisions"
msgstr "Smazat všechny starší verze"

#: includes/class-minn-admin-db.php:2582
msgid "Back up first. This removes every saved revision permanently."
msgstr "Nejprve zálohujte. Tím se trvale odstraní všechny uložené starší verze."

#: includes/class-minn-admin-db.php:2592
msgid "Spam and trashed comments"
msgstr "Spam a komentáře v koši"

#: includes/class-minn-admin-db.php:2595
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Spam a komentáře v koši zůstávají v databázi, dokud je nevyprázdníte. WordPress je po čase smaže sám."

#: includes/class-minn-admin-db.php:2596
msgid "No spam or trashed comments are waiting."
msgstr "Nečeká žádný spam ani komentáře v koši."

#: includes/class-minn-admin-db.php:2598
msgid "Delete spam"
msgstr "Smazat spam"

#: includes/class-minn-admin-db.php:2600
msgid "Back up first. This permanently deletes the comments."
msgstr "Nejprve zálohujte. Tím se komentáře trvale smažou."

#: includes/class-minn-admin-db.php:2611
msgid "Expired WooCommerce sessions"
msgstr "Vypršelé relace WooCommerce"

#: includes/class-minn-admin-db.php:2614
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Vypršelé relace košíku by měl mazat naplánovaná úloha WooCommerce. Velký skluz obvykle znamená, že úloha přestala běžet."

#: includes/class-minn-admin-db.php:2615
msgid "No expired sessions are left behind."
msgstr "Nezůstaly žádné vypršelé relace."

#: includes/class-minn-admin-db.php:2617
msgid "Delete expired sessions"
msgstr "Smazat vypršelé relace"

#: includes/class-minn-admin-db.php:2619
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Nejprve zálohujte. Nakupující s vypršelým košíkem ho ztratí, což už z definice nastalo."

#: includes/class-minn-admin-db.php:2630
msgid "Action Scheduler backlog"
msgstr "Fronta Action Scheduler"

#: includes/class-minn-admin-db.php:2633
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Čekající a selhané úlohy na pozadí. Stálý skluz je na rušném obchodě běžný; velmi velký značí, že fronta se nevyprazdňuje."

#: includes/class-minn-admin-db.php:2634
msgid "No pending or failed background jobs."
msgstr "Žádné čekající ani selhané úlohy na pozadí."

#: includes/class-minn-admin-db.php:2636
msgid "Clean the queue"
msgstr "Vyčistit frontu"

#: includes/class-minn-admin-db.php:2638
msgid "Removes finished actions. Pending work is left alone."
msgstr "Odstraní dokončené akce. Čekající práci nechá být."

#: includes/class-minn-admin-egress.php:142
msgid "Part of this change was not saved: it moves or changes a hidden key, shown as [redacted:…]. Type the real value instead."
msgstr "Část této změny se neuložila: přesouvá nebo mění skrytý klíč, zobrazený jako [redacted:…]. Místo něj zadejte skutečnou hodnotu."

#: includes/class-minn-admin-egress.php:748
#: includes/kernel/class-minn-admin-kernel-settings.php:733
msgid "Nothing was saved: this change holds a hidden key, shown as [redacted:…], and saving it would put that placeholder where the key was. Type the real value in its place, or leave that part as it was."
msgstr "Nic se neuložilo: tato změna obsahuje skrytý klíč, zobrazený jako [redacted:…], a jejím uložením by se na místo klíče dostal tento zástupný text. Zadejte na jeho místo skutečnou hodnotu, nebo tu část nechte, jak byla."

#: includes/class-minn-admin-egress.php:767
msgid "This holds a saved key (an API or licence key), and Minn never hands one out, so the export file was not made: it would not import correctly without the key."
msgstr "Obsahuje uložený klíč (klíč API nebo licenční klíč) a Minn klíče nikdy nevydává, proto se exportní soubor nevytvořil: bez klíče by se správně neimportoval."

#: includes/class-minn-admin-fences.php:202
msgid "Part of this change was not saved: it would have changed who can run this site, which your account can’t do."
msgstr "Část této změny se neuložila: změnila by, kdo smí tento web spravovat, což váš účet nemůže."

#: includes/class-minn-admin-logs.php:93
msgid "PHP error log"
msgstr "Protokol chyb PHP"

#: includes/class-minn-admin-logs.php:93
#: includes/class-minn-admin-rest.php:13869
msgid "Server"
msgstr "Server"

#: includes/class-minn-admin-logs.php:175
#: includes/class-minn-admin-logs.php:200
msgid "Unknown log source."
msgstr "Neznámý zdroj protokolu."

#: includes/class-minn-admin-logs.php:180
msgid "Could not read this log."
msgstr "Tento protokol se nepodařilo přečíst."

#: includes/class-minn-admin-logs.php:203
msgid "This log cannot be cleared from here."
msgstr "Tento protokol odtud nelze vymazat."

#: includes/class-minn-admin-logs.php:208
#: includes/class-minn-admin-logs.php:301
msgid "Could not clear the log."
msgstr "Protokol se nepodařilo vymazat."

#: includes/class-minn-admin-logs.php:231
msgid "This log lives outside the site, so Minn does not read it."
msgstr "Tento protokol je mimo web, Minn ho nenačítá."

#: includes/class-minn-admin-logs.php:297
msgid "This log is not writable."
msgstr "Tento protokol není zapisovatelný."

#: includes/class-minn-admin-notices.php:742
#: assets/js/app.js:7188
#: assets/js/app.js:19105
#: assets/js/app.js:49441
msgid "Open"
msgstr "Otevřít"

#: includes/class-minn-admin-notices.php:987
msgid "That notice action is not supported."
msgstr "Tato akce oznámení není podporována."

#: includes/class-minn-admin-notices.php:997
msgid "That notice action does not declare a capability."
msgstr "Tato akce oznámení neuvádí oprávnění."

#: includes/class-minn-admin-notices.php:1000
msgid "You cannot run that notice action."
msgstr "Tuto akci oznámení nemůžete spustit."

#: includes/class-minn-admin-notices.php:1020
msgid "You cannot dismiss this notice."
msgstr "Toto oznámení nemůžete zavřít."

#: includes/class-minn-admin-notices.php:1039
msgid "You cannot answer this notice."
msgstr "Na toto oznámení nemůžete odpovědět."

