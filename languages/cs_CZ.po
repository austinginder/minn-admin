msgstr "Název v URL je povinný: malá písmena, číslice, pomlčky nebo podtržítka, nejvýše 32 znaků."

#: includes/class-minn-admin-cpt.php:833
msgid "No such taxonomy."
msgstr "Taková taxonomie neexistuje."

#: includes/class-minn-admin-cpt.php:842
msgid "This taxonomy is registered in code and can only be changed there."
msgstr "Tato taxonomie je registrována v kódu a změnit ji lze jen tam."

#: includes/class-minn-admin-cpt.php:904
msgid "This taxonomy is registered in code and can only be removed there."
msgstr "Tato taxonomie je registrována v kódu a odstranit ji lze jen tam."

#: includes/class-minn-admin-cpt.php:907
msgid "Definition removed; existing terms stay in the database."
msgstr "Definice odstraněna; existující termíny zůstávají v databázi."

#: includes/class-minn-admin-cpt.php:946
msgid "ACF could not save the taxonomy."
msgstr "ACF nemohl taxonomii uložit."

#: includes/class-minn-admin-cpt.php:1020
msgid "ACF could not save the post type."
msgstr "ACF nemohl typ příspěvku uložit."

#: includes/class-minn-admin-cpt.php:1087
#: includes/class-minn-admin-cpt.php:1090
msgid "JetEngine could not save the post type."
msgstr "JetEngine nemohl uložit typ příspěvku."

#: includes/class-minn-admin-cpt.php:1134
#: includes/class-minn-admin-cpt.php:1137
msgid "JetEngine could not save the taxonomy."
msgstr "JetEngine nemohl uložit taxonomii."

#: includes/class-minn-admin-cpt.php:1145
msgid "JetEngine definition not found."
msgstr "Definice JetEngine nebyla nalezena."

#: includes/class-minn-admin-cpt.php:1152
#: includes/class-minn-admin-cpt.php:1154
msgid "JetEngine could not remove the definition."
msgstr "JetEngine nemohl definici odstranit."

#: includes/class-minn-admin-db.php:1312
#: includes/class-minn-admin-db.php:1341
#: includes/class-minn-admin-db.php:1503
msgid "Unknown table."
msgstr "Neznámá tabulka."

#: includes/class-minn-admin-db.php:1316
#: includes/class-minn-admin-db.php:1345
msgid "Could not read the table structure."
msgstr "Strukturu tabulky se nepodařilo načíst."

#: includes/class-minn-admin-db.php:1384
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Tento sloupec obsahuje hesla nebo tokeny, takže ho nelze prohledávat."

#: includes/class-minn-admin-db.php:1408
msgid "This site holds too many credentials for Minn to check a value search against, so values cannot be searched here."
msgstr "Na tomto webu je příliš mnoho přihlašovacích údajů, než aby Minn mohl ověřit hledání hodnoty, takže hodnoty zde nelze hledat."

#: includes/class-minn-admin-db.php:1509
msgid "This table has no usable primary key."
msgstr "Tato tabulka nemá použitelný primární klíč."

#: includes/class-minn-admin-db.php:1519
msgid "Row not found."
msgstr "Řádek nebyl nalezen."

#: includes/class-minn-admin-db.php:1578
msgid "Not checked"
msgstr "Nezkontrolováno"

#: includes/class-minn-admin-db.php:1579
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Tato tabulka je na levné spočítání příliš velká, proto ji Minn neskenuje. Ke kontrole spusťte příkaz níže."

#: includes/class-minn-admin-db.php:1629
msgid "Database hygiene"
msgstr "Hygiena databáze"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:1635
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s kontrola úložiště vyžaduje pozornost"
msgstr[1] "%s kontroly úložiště vyžadují pozornost"
msgstr[2] "%s kontrol úložiště vyžaduje pozornost"

#: includes/class-minn-admin-db.php:1643
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Osiřelé řádky, indexy i enginy vypadají v pořádku"

#: includes/class-minn-admin-db.php:1710
msgid "Tables without a primary key"
msgstr "Tabulky bez primárního klíče"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1716
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Tyto tabulky nemají primární klíč, což rozbíjí replikaci po řádcích a mate nástroje pro zálohy a migrace: %s"

#: includes/class-minn-admin-db.php:1719
msgid "Every table has a primary key."
msgstr "Každá tabulka má primární klíč."

#: includes/class-minn-admin-db.php:1731
msgid "Storage engine"
msgstr "Úložný engine"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:1737
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Tyto tabulky nepoužívají InnoDB, proto jim chybí zamykání řádků a obnova po pádu: %s"

#: includes/class-minn-admin-db.php:1740
msgid "Every table uses InnoDB."
msgstr "Každá tabulka používá InnoDB."

#: includes/class-minn-admin-db.php:1742
msgid "Convert a table"
msgstr "Převést tabulku"

#: includes/class-minn-admin-db.php:1744
msgid "Back up first. Converting locks the table while it runs."
msgstr "Nejprve zálohujte. Převod tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:1763
msgid "Reclaimable space"
msgstr "Získatelné místo"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:1770
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Jen %1$s drží %2$s volného místa ve vlastním souboru. Optimalizace tabulku přepíše a místo vrátí disku."

#: includes/class-minn-admin-db.php:1774
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Žádná tabulka nedrží významné množství získatelného místa."

#: includes/class-minn-admin-db.php:1776
msgid "Optimise tables"
msgstr "Optimalizovat tabulky"

#: includes/class-minn-admin-db.php:1778
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Nejprve zálohujte. Optimalizace každou tabulku po dobu běhu zamkne."

#: includes/class-minn-admin-db.php:1796
msgid "Post meta lookup index"
msgstr "Index vyhledávání post meta"

#: includes/class-minn-admin-db.php:1799
msgid "Present"
msgstr "Přítomen"

#: includes/class-minn-admin-db.php:1801
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Kombinovaný index post_id a meta_key je přítomen, proto vyhledávání meta zůstává rychlé."

#: includes/class-minn-admin-db.php:1802
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Vyhledávání podle příspěvku a meta klíče padá na dva samostatné indexy. Na webech s hodně meta (WooCommerce, pluginy událostí a rezervací) je kombinovaný index velká a málo riziková výhra."

#: includes/class-minn-admin-db.php:1804
msgid "Add the index"
msgstr "Přidat index"

#: includes/class-minn-admin-db.php:1806
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Nejprve zálohujte. Přidání indexu tabulku krátce zamkne."

#: includes/class-minn-admin-db.php:1850
msgid "Auto-increment headroom"
msgstr "Rezerva auto-increment"

#: includes/class-minn-admin-db.php:1852
msgid "Healthy"
msgstr "Zdravé"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1857
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Tyto tabulky jsou do 20 procent od největšího id, které typ sloupce unese. Po dosažení stropu se nové řádky přestanou zapisovat: %s"

#: includes/class-minn-admin-db.php:1860
msgid "No table is close to exhausting its id column."
msgstr "Žádná tabulka se neblíží vyčerpání sloupce id."

#: includes/class-minn-admin-db.php:1868
msgid "Orphaned post meta"
msgstr "Osiřelá post meta"

#: includes/class-minn-admin-db.php:1871
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Tyto meta řádky patří k příspěvkům, které už neexistují. Jsou zátěží v každém dotazu na post meta."

#: includes/class-minn-admin-db.php:1872
msgid "Every meta row belongs to a post that still exists."
msgstr "Každý meta řádek patří k příspěvku, který stále existuje."

#: includes/class-minn-admin-db.php:1874
#: includes/class-minn-admin-db.php:1892
#: includes/class-minn-admin-db.php:1910
msgid "Delete them"
msgstr "Smazat je"

#: includes/class-minn-admin-db.php:1876
#: includes/class-minn-admin-db.php:1894
#: includes/class-minn-admin-db.php:1912
msgid "Back up first. This permanently deletes rows."
msgstr "Nejprve zálohujte. Tím se řádky trvale smažou."

#: includes/class-minn-admin-db.php:1886
msgid "Orphaned user meta"
msgstr "Osiřelá user meta"

#: includes/class-minn-admin-db.php:1889
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Tyto meta řádky patří k uživatelům, kteří už neexistují, obvykle po pluginu, který účty smazal přímo."

#: includes/class-minn-admin-db.php:1890
msgid "Every meta row belongs to a user who still exists."
msgstr "Každý meta řádek patří k uživateli, který stále existuje."

#: includes/class-minn-admin-db.php:1904
msgid "Orphaned term relationships"
msgstr "Osiřelé vztahy termínů"

#: includes/class-minn-admin-db.php:1907
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Tyto řádky propojují obsah s rubrikami nebo štítky, které už neexistují."

#: includes/class-minn-admin-db.php:1908
msgid "Every relationship points at a term that still exists."
msgstr "Každý vztah ukazuje na termín, který stále existuje."

#: includes/class-minn-admin-db.php:1922
msgid "Stored revisions"
msgstr "Uložené starší verze"

#: includes/class-minn-admin-db.php:1925
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Starší verze jsou záchranná síť editoru, proto je velký počet normální a není chyba. Mazat je má smysl, jen když tabulka příspěvků přerostla."

#: includes/class-minn-admin-db.php:1926
msgid "No revisions are stored."
msgstr "Nejsou uloženy žádné starší verze."

#: includes/class-minn-admin-db.php:1928
msgid "Delete all revisions"
msgstr "Smazat všechny starší verze"

#: includes/class-minn-admin-db.php:1930
msgid "Back up first. This removes every saved revision permanently."
msgstr "Nejprve zálohujte. Tím se trvale odstraní všechny uložené starší verze."

#: includes/class-minn-admin-db.php:1940
msgid "Spam and trashed comments"
msgstr "Spam a komentáře v koši"

#: includes/class-minn-admin-db.php:1943
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Spam a komentáře v koši zůstávají v databázi, dokud je nevyprázdníte. WordPress je po čase smaže sám."

#: includes/class-minn-admin-db.php:1944
msgid "No spam or trashed comments are waiting."
msgstr "Nečeká žádný spam ani komentáře v koši."

#: includes/class-minn-admin-db.php:1946
msgid "Delete spam"
msgstr "Smazat spam"

#: includes/class-minn-admin-db.php:1948
msgid "Back up first. This permanently deletes the comments."
msgstr "Nejprve zálohujte. Tím se komentáře trvale smažou."

#: includes/class-minn-admin-db.php:1959
msgid "Expired WooCommerce sessions"
msgstr "Vypršelé relace WooCommerce"

#: includes/class-minn-admin-db.php:1962
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Vypršelé relace košíku by měl mazat naplánovaná úloha WooCommerce. Velký skluz obvykle znamená, že úloha přestala běžet."

#: includes/class-minn-admin-db.php:1963
msgid "No expired sessions are left behind."
msgstr "Nezůstaly žádné vypršelé relace."

#: includes/class-minn-admin-db.php:1965
msgid "Delete expired sessions"
msgstr "Smazat vypršelé relace"

#: includes/class-minn-admin-db.php:1967
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Nejprve zálohujte. Nakupující s vypršelým košíkem ho ztratí, což už z definice nastalo."

#: includes/class-minn-admin-db.php:1978
msgid "Action Scheduler backlog"
msgstr "Fronta Action Scheduler"

