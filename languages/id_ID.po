#: includes/class-minn-admin-db.php:912
msgid "Present"
msgstr "Ada"

#: includes/class-minn-admin-db.php:914
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Indeks gabungan post_id dan meta_key ada, jadi pencarian meta tetap cepat."

#: includes/class-minn-admin-db.php:915
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Pencarian berdasarkan pos dan kunci meta jatuh ke dua indeks terpisah. Di situs dengan pemakaian meta berat (WooCommerce, plugin peristiwa dan pemesanan) indeks gabungan adalah peningkatan kecepatan yang besar dan berisiko rendah."

#: includes/class-minn-admin-db.php:917
msgid "Add the index"
msgstr "Tambah indeks"

#: includes/class-minn-admin-db.php:919
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Cadangkan terlebih dahulu. Menambah indeks mengunci tabel sebentar."

#: includes/class-minn-admin-db.php:963
msgid "Auto-increment headroom"
msgstr "Ruang auto-increment"

#: includes/class-minn-admin-db.php:965
msgid "Healthy"
msgstr "Sehat"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:970
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
