msgstr "Modifikasi berkas dinonaktifkan di situs ini."

#: includes/class-minn-admin-rest.php:13929
msgid "wp-config.php is not writable."
msgstr "wp-config.php tidak dapat ditulisi."

#: includes/class-minn-admin-rest.php:13933
msgid "Could not read wp-config.php."
msgstr "Tidak dapat membaca wp-config.php."

