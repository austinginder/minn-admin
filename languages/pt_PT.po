msgstr "Essa coluna contém palavras-passe ou tokens, por isso não pode ser pesquisada."

#: includes/class-minn-admin-db.php:995
msgid "This table has no usable primary key."
msgstr "Esta tabela não tem uma chave primária utilizável."

#: includes/class-minn-admin-db.php:1005
