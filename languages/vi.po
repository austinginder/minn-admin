#: includes/class-minn-admin-cpt.php:613
msgid "This taxonomy is registered in code and can only be removed there."
msgstr "Phân loại này được đăng ký trong mã và chỉ có thể xóa bỏ ở đó."

#: includes/class-minn-admin-cpt.php:616
msgid "Definition removed; existing terms stay in the database."
msgstr "Đã xóa bỏ định nghĩa; các thuật ngữ hiện có vẫn được giữ trong cơ sở dữ liệu."

#: includes/class-minn-admin-cpt.php:653
