msgid "Could not write a rollback copy of wp-config.php, so the change was not made."
msgstr "Không thể ghi bản sao rollback của wp-config.php, nên thay đổi chưa được thực hiện."

#. translators: %s: the file name of the kept copy of wp-config.php.
#: includes/class-minn-admin-rest.php:14723
msgid "wp-config.php did not save completely and could not be put back. A copy of the original is kept as %s."
msgstr "wp-config.php không được lưu hoàn chỉnh và không thể khôi phục lại. Một bản sao của tệp gốc được giữ lại dưới tên %s."

#: includes/class-minn-admin-rest.php:14776
msgid "wp-config.php did not save completely, so it was put back as it was. Nothing changed."
msgstr "wp-config.php không được lưu hoàn chỉnh, nên đã được khôi phục như cũ. Không có gì thay đổi."

#: includes/class-minn-admin-rest.php:14778
msgid "wp-config.php did not save completely and could not be put back."
msgstr "wp-config.php không được lưu hoàn chỉnh và không thể khôi phục lại."

