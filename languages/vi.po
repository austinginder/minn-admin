#: includes/class-minn-admin-rest.php:8068
msgid "Widths and spacing take a CSS length such as 24px, 1.5rem or 5%."
msgstr "Độ rộng và khoảng cách nhận chiều dài CSS như 24px, 1.5rem hoặc 5%."

#: includes/class-minn-admin-rest.php:8070
msgid "Unsupported value."
msgstr "Giá trị không được hỗ trợ."

