#: includes/class-minn-admin-db.php:791
msgid "Optimise tables"
msgstr "Tối ưu hóa bảng"

#: includes/class-minn-admin-db.php:793
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Sao lưu trước. Việc tối ưu hóa sẽ khóa từng bảng trong khi chạy."

#: includes/class-minn-admin-db.php:811
msgid "Post meta lookup index"
msgstr "Chỉ mục tra cứu meta bài viết"

#: includes/class-minn-admin-db.php:814
msgid "Present"
msgstr "Có"

#: includes/class-minn-admin-db.php:816
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Đã có chỉ mục kết hợp post_id và meta_key, nên các tra cứu meta luôn nhanh."

#: includes/class-minn-admin-db.php:817
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Tra cứu theo bài viết và khóa meta phải dùng hai chỉ mục riêng lẻ. Trên các trang dùng nhiều meta (WooCommerce, plugin sự kiện và đặt chỗ), một chỉ mục kết hợp là cải thiện tốc độ lớn, ít rủi ro."

#: includes/class-minn-admin-db.php:819
msgid "Add the index"
msgstr "Thêm chỉ mục"

#: includes/class-minn-admin-db.php:821
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Sao lưu trước. Việc thêm chỉ mục sẽ khóa bảng trong chốc lát."

#: includes/class-minn-admin-db.php:865
msgid "Auto-increment headroom"
msgstr "Dư địa auto-increment"

#: includes/class-minn-admin-db.php:867
msgid "Healthy"
msgstr "Khỏe mạnh"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:872
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Các bảng này đã dùng đến trong vòng 20 phần trăm của id lớn nhất mà kiểu cột có thể lưu. Khi chạm trần, các hàng mới sẽ không được ghi nữa: %s"

#: includes/class-minn-admin-db.php:875
msgid "No table is close to exhausting its id column."
msgstr "Không có bảng nào sắp cạn cột id."

#: includes/class-minn-admin-db.php:883
msgid "Orphaned post meta"
msgstr "Meta bài viết mồ côi"

#: includes/class-minn-admin-db.php:886
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Các hàng meta này thuộc về những bài viết không còn tồn tại. Chúng là gánh nặng vô ích trong mọi truy vấn chạm đến meta bài viết."

#: includes/class-minn-admin-db.php:887
msgid "Every meta row belongs to a post that still exists."
msgstr "Mọi hàng meta đều thuộc về một bài viết vẫn còn tồn tại."

#: includes/class-minn-admin-db.php:889
#: includes/class-minn-admin-db.php:907
#: includes/class-minn-admin-db.php:925
msgid "Delete them"
msgstr "Xóa chúng"

#: includes/class-minn-admin-db.php:891
#: includes/class-minn-admin-db.php:909
#: includes/class-minn-admin-db.php:927
msgid "Back up first. This permanently deletes rows."
msgstr "Sao lưu trước. Thao tác này xóa vĩnh viễn các hàng."

#: includes/class-minn-admin-db.php:901
msgid "Orphaned user meta"
msgstr "Meta người dùng mồ côi"

#: includes/class-minn-admin-db.php:904
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Các hàng meta này thuộc về những người dùng không còn tồn tại, thường do một plugin xóa tài khoản trực tiếp để lại."

#: includes/class-minn-admin-db.php:905
msgid "Every meta row belongs to a user who still exists."
msgstr "Mọi hàng meta đều thuộc về một người dùng vẫn còn tồn tại."

#: includes/class-minn-admin-db.php:919
msgid "Orphaned term relationships"
msgstr "Quan hệ thuật ngữ mồ côi"

#: includes/class-minn-admin-db.php:922
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Các hàng này liên kết nội dung với danh mục hoặc thẻ không còn tồn tại."

#: includes/class-minn-admin-db.php:923
msgid "Every relationship points at a term that still exists."
msgstr "Mọi quan hệ đều trỏ đến một thuật ngữ vẫn còn tồn tại."

#: includes/class-minn-admin-db.php:937
msgid "Stored revisions"
msgstr "Lịch sử sửa đã lưu"

#: includes/class-minn-admin-db.php:940
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Lịch sử sửa là lưới an toàn của trình soạn thảo, nên số lượng lớn là bình thường, không phải lỗi. Chỉ đáng cắt bớt khi bảng bài viết đã phình quá lớn."

#: includes/class-minn-admin-db.php:941
msgid "No revisions are stored."
msgstr "Không có lịch sử sửa nào được lưu."

#: includes/class-minn-admin-db.php:943
msgid "Delete all revisions"
msgstr "Xóa toàn bộ lịch sử sửa"

#: includes/class-minn-admin-db.php:945
msgid "Back up first. This removes every saved revision permanently."
msgstr "Sao lưu trước. Thao tác này xóa vĩnh viễn mọi bản lịch sử sửa đã lưu."

#: includes/class-minn-admin-db.php:955
msgid "Spam and trashed comments"
msgstr "Bình luận spam và trong thùng rác"

#: includes/class-minn-admin-db.php:958
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Bình luận spam và trong thùng rác vẫn nằm trong cơ sở dữ liệu cho đến khi được dọn sạch. WordPress sẽ tự xóa chúng sau một thời gian."

#: includes/class-minn-admin-db.php:959
msgid "No spam or trashed comments are waiting."
msgstr "Không có bình luận spam hoặc trong thùng rác nào đang chờ."

#: includes/class-minn-admin-db.php:961
msgid "Delete spam"
msgstr "Xóa spam"

#: includes/class-minn-admin-db.php:963
msgid "Back up first. This permanently deletes the comments."
msgstr "Sao lưu trước. Thao tác này xóa vĩnh viễn các bình luận."

#: includes/class-minn-admin-db.php:974
msgid "Expired WooCommerce sessions"
msgstr "Phiên WooCommerce đã hết hạn"

#: includes/class-minn-admin-db.php:977
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Các phiên giỏ hàng hết hạn lẽ ra được xóa bởi một tác vụ định kỳ của WooCommerce. Tồn đọng lớn thường có nghĩa là tác vụ đó đã ngừng chạy."

#: includes/class-minn-admin-db.php:978
msgid "No expired sessions are left behind."
msgstr "Không còn phiên hết hạn nào bị bỏ lại."

#: includes/class-minn-admin-db.php:980
msgid "Delete expired sessions"
msgstr "Xóa các phiên đã hết hạn"

#: includes/class-minn-admin-db.php:982
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Sao lưu trước. Người mua có giỏ hàng hết hạn sẽ mất giỏ, mà theo định nghĩa thì điều đó đã xảy ra rồi."

#: includes/class-minn-admin-db.php:993
msgid "Action Scheduler backlog"
msgstr "Tồn đọng Action Scheduler"

#: includes/class-minn-admin-db.php:996
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Các tác vụ nền đang chờ và không thành công. Tồn đọng đều đặn là bình thường trên một cửa hàng bận rộn; tồn đọng rất lớn cho thấy hàng đợi không được giải phóng."

#: includes/class-minn-admin-db.php:997
msgid "No pending or failed background jobs."
msgstr "Không có tác vụ nền nào đang chờ hoặc không thành công."

#: includes/class-minn-admin-db.php:999
msgid "Clean the queue"
msgstr "Dọn hàng đợi"

#: includes/class-minn-admin-db.php:1001
msgid "Removes finished actions. Pending work is left alone."
msgstr "Xóa bỏ các tác vụ đã hoàn tất. Công việc đang chờ được giữ nguyên."

