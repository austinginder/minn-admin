msgid "Minn Admin update rejected: the package does not come from Minn Admin's own release, so it cannot be verified."
msgstr "Đã từ chối cập nhật Minn Admin: gói không đến từ bản phát hành của chính Minn Admin, nên không kiểm chứng được."

#: includes/class-minn-admin-updater.php:424
msgid "Minn Admin update rejected: the release manifest could not be reached, so the download could not be verified. Try again shortly."
msgstr "Bản cập nhật Minn Admin bị từ chối: không kết nối được manifest phát hành, nên không thể xác minh bản tải xuống. Hãy thử lại sau."

#: includes/class-minn-admin-updater.php:435
msgid "Minn Admin update rejected: the release manifest does not publish a sha256 for this package."
msgstr "Bản cập nhật Minn Admin bị từ chối: manifest phát hành không công bố sha256 cho gói này."

#: includes/class-minn-admin-updater.php:467
msgid "Minn Admin update rejected: the downloaded package does not match the sha256 published in the release manifest."
msgstr "Bản cập nhật Minn Admin bị từ chối: gói đã tải không khớp sha256 được công bố trong manifest phát hành."

