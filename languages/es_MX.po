#: includes/class-minn-admin-rest.php:6528
msgid "Manage the Perfmatters settings estate from Minn's Performance surface. Download the paid plugin .zip from Perfmatters."
msgstr "Gestiona todos los ajustes de Perfmatters desde la superficie Rendimiento de Minn. Descarga el archivo .zip del plugin de pago desde Perfmatters."

#: includes/class-minn-admin-rest.php:6540
msgid "Bring ACF PRO repeaters, flexible content, galleries, options pages, blocks, and field groups into Minn. Download the plugin .zip from ACF."
msgstr "Incorpora a Minn los repetidores, el contenido flexible, las galerías, las páginas de opciones, los bloques y los grupos de campos de ACF PRO. Descarga el archivo .zip del plugin desde ACF."

#: includes/class-minn-admin-rest.php:6552
