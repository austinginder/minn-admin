#: includes/class-minn-admin-db.php:1707
#: includes/class-minn-admin-db.php:1736
#: includes/class-minn-admin-db.php:1898
msgid "Unknown table."
msgstr "Tabla desconocida."

#: includes/class-minn-admin-db.php:1711
#: includes/class-minn-admin-db.php:1740
msgid "Could not read the table structure."
msgstr "No se ha podido leer la estructura de la tabla."

#: includes/class-minn-admin-db.php:1779
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Esa columna contiene contraseñas o tokens, así que no se puede buscar en ella."

#: includes/class-minn-admin-db.php:1802
msgid "This site holds too many credentials for Minn to check a value search against, so values cannot be searched here."
msgstr "Este sitio almacena demasiadas credenciales para que Minn compruebe una búsqueda por valor, así que los valores no se pueden buscar aquí."

#: includes/class-minn-admin-db.php:1904
msgid "This table has no usable primary key."
msgstr "Esta tabla no tiene una clave primaria utilizable."

#: includes/class-minn-admin-db.php:1914
msgid "Row not found."
msgstr "Fila no encontrada."

#: includes/class-minn-admin-db.php:1981
msgid "Not checked"
msgstr "Sin comprobar"

#: includes/class-minn-admin-db.php:1982
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Esta tabla es demasiado grande para contarla de forma económica, así que Minn no la analiza. Ejecuta el comando de abajo para comprobarla."

#: includes/class-minn-admin-db.php:2041
msgid "Database hygiene"
msgstr "Higiene de la base de datos"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:2047
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s comprobación de almacenamiento necesita atención"
msgstr[1] "%s comprobaciones de almacenamiento necesitan atención"

#: includes/class-minn-admin-db.php:2055
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Las filas huérfanas, los índices y los motores parecen correctos"

#: includes/class-minn-admin-db.php:2122
msgid "Tables without a primary key"
msgstr "Tablas sin clave primaria"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2128
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Estas tablas no tienen clave primaria, lo que rompe la replicación por filas y confunde a las herramientas de copia y migración: %s"

#: includes/class-minn-admin-db.php:2131
msgid "Every table has a primary key."
msgstr "Todas las tablas tienen clave primaria."

#: includes/class-minn-admin-db.php:2143
msgid "Storage engine"
msgstr "Motor de almacenamiento"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:2149
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Estas tablas no usan InnoDB, así que no tienen bloqueo por filas ni recuperación ante caídas: %s"

#: includes/class-minn-admin-db.php:2152
msgid "Every table uses InnoDB."
msgstr "Todas las tablas usan InnoDB."

#: includes/class-minn-admin-db.php:2154
msgid "Convert a table"
msgstr "Convertir una tabla"

#: includes/class-minn-admin-db.php:2156
msgid "Back up first. Converting locks the table while it runs."
msgstr "Haz antes una copia de seguridad. La conversión bloquea la tabla mientras se ejecuta."

#: includes/class-minn-admin-db.php:2175
msgid "Reclaimable space"
msgstr "Espacio recuperable"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:2182
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Solo %1$s retiene %2$s de espacio libre dentro de su propio archivo. Optimizarla reescribe la tabla y devuelve ese espacio al disco."

#: includes/class-minn-admin-db.php:2186
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Ninguna tabla retiene una cantidad significativa de espacio recuperable."

#: includes/class-minn-admin-db.php:2188
msgid "Optimise tables"
msgstr "Optimizar las tablas"

#: includes/class-minn-admin-db.php:2190
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Haz antes una copia de seguridad. La optimización bloquea cada tabla mientras se ejecuta."

#: includes/class-minn-admin-db.php:2208
msgid "Post meta lookup index"
msgstr "Índice de búsqueda de meta de entradas"

#: includes/class-minn-admin-db.php:2211
msgid "Present"
msgstr "Presente"

#: includes/class-minn-admin-db.php:2213
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Existe un índice combinado de post_id y meta_key, así que las búsquedas de meta siguen siendo rápidas."

#: includes/class-minn-admin-db.php:2214
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Las búsquedas por entrada y clave meta recurren a dos índices separados. En sitios con mucho uso de meta (WooCommerce, plugins de eventos y reservas) un índice combinado es una mejora de velocidad grande y de bajo riesgo."

#: includes/class-minn-admin-db.php:2216
msgid "Add the index"
msgstr "Añadir el índice"

#: includes/class-minn-admin-db.php:2218
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Haz antes una copia de seguridad. Añadir un índice bloquea la tabla brevemente."

#: includes/class-minn-admin-db.php:2262
msgid "Auto-increment headroom"
msgstr "Margen del auto-incremento"

#: includes/class-minn-admin-db.php:2264
msgid "Healthy"
msgstr "Correcto"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:2269
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Estas tablas están dentro del 20 por ciento del mayor id que puede almacenar su tipo de columna. Al llegar al techo, dejan de escribirse filas nuevas: %s"

#: includes/class-minn-admin-db.php:2272
msgid "No table is close to exhausting its id column."
msgstr "Ninguna tabla está cerca de agotar su columna de id."

#: includes/class-minn-admin-db.php:2280
msgid "Orphaned post meta"
msgstr "Meta de entradas huérfana"

#: includes/class-minn-admin-db.php:2283
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Estas filas meta pertenecen a entradas que ya no existen. Son peso muerto en cada consulta que toca la meta de entradas."

#: includes/class-minn-admin-db.php:2284
msgid "Every meta row belongs to a post that still exists."
msgstr "Todas las filas meta pertenecen a una entrada que sigue existiendo."

#: includes/class-minn-admin-db.php:2286
#: includes/class-minn-admin-db.php:2304
#: includes/class-minn-admin-db.php:2322
msgid "Delete them"
msgstr "Borrarlas"

#: includes/class-minn-admin-db.php:2288
#: includes/class-minn-admin-db.php:2306
#: includes/class-minn-admin-db.php:2324
msgid "Back up first. This permanently deletes rows."
msgstr "Haz antes una copia de seguridad. Esto borra filas permanentemente."

#: includes/class-minn-admin-db.php:2298
msgid "Orphaned user meta"
msgstr "Meta de usuarios huérfana"

#: includes/class-minn-admin-db.php:2301
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Estas filas meta pertenecen a usuarios que ya no existen, normalmente restos de un plugin que eliminó cuentas directamente."

#: includes/class-minn-admin-db.php:2302
msgid "Every meta row belongs to a user who still exists."
msgstr "Todas las filas meta pertenecen a un usuario que sigue existiendo."

#: includes/class-minn-admin-db.php:2316
msgid "Orphaned term relationships"
msgstr "Relaciones de términos huérfanas"

#: includes/class-minn-admin-db.php:2319
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Estas filas enlazan contenido con categorías o etiquetas que ya no existen."

#: includes/class-minn-admin-db.php:2320
msgid "Every relationship points at a term that still exists."
msgstr "Todas las relaciones apuntan a un término que sigue existiendo."

#: includes/class-minn-admin-db.php:2334
msgid "Stored revisions"
msgstr "Revisiones guardadas"

#: includes/class-minn-admin-db.php:2337
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Las revisiones son la red de seguridad del editor, así que tener muchas es normal y no es un fallo. Recortarlas solo merece la pena si la tabla de entradas se ha vuelto inmanejable."

#: includes/class-minn-admin-db.php:2338
msgid "No revisions are stored."
msgstr "No hay revisiones guardadas."

#: includes/class-minn-admin-db.php:2340
msgid "Delete all revisions"
msgstr "Borrar todas las revisiones"

#: includes/class-minn-admin-db.php:2342
msgid "Back up first. This removes every saved revision permanently."
msgstr "Haz antes una copia de seguridad. Esto elimina permanentemente todas las revisiones guardadas."

#: includes/class-minn-admin-db.php:2352
msgid "Spam and trashed comments"
msgstr "Comentarios de spam y en la papelera"

#: includes/class-minn-admin-db.php:2355
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Los comentarios de spam y de la papelera siguen en la base de datos hasta que se vacían. WordPress los limpia por su cuenta pasado un tiempo."

#: includes/class-minn-admin-db.php:2356
msgid "No spam or trashed comments are waiting."
msgstr "No hay comentarios de spam ni en la papelera."

#: includes/class-minn-admin-db.php:2358
msgid "Delete spam"
msgstr "Borrar el spam"

#: includes/class-minn-admin-db.php:2360
msgid "Back up first. This permanently deletes the comments."
