#: includes/class-minn-admin-db.php:1984
msgid "No table is close to exhausting its id column."
msgstr "Ninguna tabla está cerca de agotar su columna de id."

#: includes/class-minn-admin-db.php:1992
msgid "Orphaned post meta"
msgstr "Meta de entradas huérfana"

#: includes/class-minn-admin-db.php:1995
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Estas filas meta pertenecen a entradas que ya no existen. Son peso muerto en cada consulta que toca la meta de entradas."

#: includes/class-minn-admin-db.php:1996
msgid "Every meta row belongs to a post that still exists."
msgstr "Todas las filas meta pertenecen a una entrada que sigue existiendo."

#: includes/class-minn-admin-db.php:1998
#: includes/class-minn-admin-db.php:2016
#: includes/class-minn-admin-db.php:2034
msgid "Delete them"
msgstr "Borrarlas"

#: includes/class-minn-admin-db.php:2000
#: includes/class-minn-admin-db.php:2018
#: includes/class-minn-admin-db.php:2036
msgid "Back up first. This permanently deletes rows."
msgstr "Haz antes una copia de seguridad. Esto borra filas permanentemente."

#: includes/class-minn-admin-db.php:2010
msgid "Orphaned user meta"
msgstr "Meta de usuarios huérfana"

#: includes/class-minn-admin-db.php:2013
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Estas filas meta pertenecen a usuarios que ya no existen, normalmente restos de un plugin que eliminó cuentas directamente."

#: includes/class-minn-admin-db.php:2014
msgid "Every meta row belongs to a user who still exists."
msgstr "Todas las filas meta pertenecen a un usuario que sigue existiendo."

#: includes/class-minn-admin-db.php:2028
msgid "Orphaned term relationships"
msgstr "Relaciones de términos huérfanas"

#: includes/class-minn-admin-db.php:2031
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Estas filas enlazan contenido con categorías o etiquetas que ya no existen."

#: includes/class-minn-admin-db.php:2032
msgid "Every relationship points at a term that still exists."
msgstr "Todas las relaciones apuntan a un término que sigue existiendo."

#: includes/class-minn-admin-db.php:2046
msgid "Stored revisions"
msgstr "Revisiones guardadas"

#: includes/class-minn-admin-db.php:2049
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Las revisiones son la red de seguridad del editor, así que tener muchas es normal y no es un fallo. Recortarlas solo merece la pena si la tabla de entradas se ha vuelto inmanejable."

#: includes/class-minn-admin-db.php:2050
msgid "No revisions are stored."
msgstr "No hay revisiones guardadas."

#: includes/class-minn-admin-db.php:2052
msgid "Delete all revisions"
msgstr "Borrar todas las revisiones"

#: includes/class-minn-admin-db.php:2054
msgid "Back up first. This removes every saved revision permanently."
msgstr "Haz antes una copia de seguridad. Esto elimina permanentemente todas las revisiones guardadas."

#: includes/class-minn-admin-db.php:2064
msgid "Spam and trashed comments"
msgstr "Comentarios de spam y en la papelera"

#: includes/class-minn-admin-db.php:2067
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Los comentarios de spam y de la papelera siguen en la base de datos hasta que se vacían. WordPress los limpia por su cuenta pasado un tiempo."

#: includes/class-minn-admin-db.php:2068
msgid "No spam or trashed comments are waiting."
msgstr "No hay comentarios de spam ni en la papelera."

#: includes/class-minn-admin-db.php:2070
msgid "Delete spam"
msgstr "Borrar el spam"

#: includes/class-minn-admin-db.php:2072
msgid "Back up first. This permanently deletes the comments."
msgstr "Haz antes una copia de seguridad. Esto borra los comentarios permanentemente."

#: includes/class-minn-admin-db.php:2083
msgid "Expired WooCommerce sessions"
msgstr "Sesiones de WooCommerce caducadas"

#: includes/class-minn-admin-db.php:2086
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Una tarea programada de WooCommerce debería limpiar las sesiones de carrito caducadas. Un acumulado grande suele significar que esa tarea ha dejado de ejecutarse."

#: includes/class-minn-admin-db.php:2087
msgid "No expired sessions are left behind."
msgstr "No queda ninguna sesión caducada."

#: includes/class-minn-admin-db.php:2089
msgid "Delete expired sessions"
msgstr "Borrar las sesiones caducadas"

#: includes/class-minn-admin-db.php:2091
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Haz antes una copia de seguridad. Los compradores con un carrito caducado lo pierden, algo que por definición ya ha ocurrido."

#: includes/class-minn-admin-db.php:2102
msgid "Action Scheduler backlog"
msgstr "Cola pendiente de Action Scheduler"

#: includes/class-minn-admin-db.php:2105
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Tareas en segundo plano pendientes y fallidas. Una cola constante es normal en una tienda con movimiento; una muy grande sugiere que no se está vaciando."

#: includes/class-minn-admin-db.php:2106
msgid "No pending or failed background jobs."
msgstr "No hay tareas en segundo plano pendientes ni fallidas."

#: includes/class-minn-admin-db.php:2108
msgid "Clean the queue"
msgstr "Limpiar la cola"

#: includes/class-minn-admin-db.php:2110
msgid "Removes finished actions. Pending work is left alone."
msgstr "Elimina las acciones terminadas. El trabajo pendiente no se toca."

