#: includes/class-minn-admin-db.php:383
#: includes/class-minn-admin-db.php:411
#: includes/class-minn-admin-db.php:520
msgid "Unknown table."
msgstr "Ismeretlen táblázat."

#: includes/class-minn-admin-db.php:387
#: includes/class-minn-admin-db.php:415
msgid "Could not read the table structure."
msgstr "A táblázat szerkezetét nem sikerült beolvasni."

#: includes/class-minn-admin-db.php:526
msgid "This table has no usable primary key."
msgstr "Ennek a táblázatnak nincs használható elsődleges kulcsa."

#: includes/class-minn-admin-db.php:536
msgid "Row not found."
msgstr "A sor nem található."

#: includes/class-minn-admin-db.php:595
msgid "Not checked"
msgstr "Nincs ellenőrizve"

#: includes/class-minn-admin-db.php:596
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Ez a táblázat túl nagy a gyors számláláshoz, ezért a Minn nem vizsgálja. Futtasd az alábbi parancsot, és ellenőrizd magad."

#: includes/class-minn-admin-db.php:646
msgid "Database hygiene"
msgstr "Adatbázis-higiénia"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:652
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s tárhely-ellenőrzés figyelmet igényel"
msgstr[1] "%s tárhely-ellenőrzés figyelmet igényel"

#: includes/class-minn-admin-db.php:660
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Az árva sorok, indexek és motorok mind rendben vannak"

#: includes/class-minn-admin-db.php:727
msgid "Tables without a primary key"
msgstr "Elsődleges kulcs nélküli táblázatok"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:733
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Ezeknek a táblázatoknak nincs elsődleges kulcsuk, ami elrontja a sorszintű replikációt, és megzavarja a mentő- és migrációs eszközöket: %s"

#: includes/class-minn-admin-db.php:736
msgid "Every table has a primary key."
msgstr "Minden táblázatnak van elsődleges kulcsa."

#: includes/class-minn-admin-db.php:748
msgid "Storage engine"
msgstr "Tárolómotor"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:754
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Ezek a táblázatok nem InnoDB-t használnak, ezért nincs sorszintű zárolásuk és összeomlás utáni helyreállításuk: %s"

#: includes/class-minn-admin-db.php:757
msgid "Every table uses InnoDB."
msgstr "Minden táblázat InnoDB-t használ."

#: includes/class-minn-admin-db.php:759
msgid "Convert a table"
msgstr "Táblázat konvertálása"

#: includes/class-minn-admin-db.php:761
msgid "Back up first. Converting locks the table while it runs."
msgstr "Először készíts biztonsági mentést. A konvertálás zárolja a táblázatot, amíg fut."

#: includes/class-minn-admin-db.php:780
msgid "Reclaimable space"
msgstr "Visszanyerhető hely"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:787
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "A(z) %1$s önmagában %2$s szabad helyet tart a saját fájljában. Az optimalizálás újraírja a táblázatot, és visszaadja a lemeznek."

#: includes/class-minn-admin-db.php:791
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Egyik táblázat sem tart jelentős visszanyerhető helyet."

#: includes/class-minn-admin-db.php:793
msgid "Optimise tables"
msgstr "Táblázatok optimalizálása"

#: includes/class-minn-admin-db.php:795
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Először készíts biztonsági mentést. Az optimalizálás zárolja az egyes táblázatokat, amíg fut."

#: includes/class-minn-admin-db.php:813
msgid "Post meta lookup index"
msgstr "Bejegyzés-meta keresőindex"

#: includes/class-minn-admin-db.php:816
msgid "Present"
msgstr "Megvan"

#: includes/class-minn-admin-db.php:818
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Van egy egyesített post_id és meta_key index, ezért a metakeresések gyorsak maradnak."

#: includes/class-minn-admin-db.php:819
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "A bejegyzés és metakulcs szerinti keresések két külön indexre esnek vissza. A sok metát használó webhelyeken (WooCommerce, esemény- és foglalási bővítmények) az egyesített index nagy, alacsony kockázatú gyorsulás."

#: includes/class-minn-admin-db.php:821
msgid "Add the index"
msgstr "Index hozzáadása"

#: includes/class-minn-admin-db.php:823
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Először készíts biztonsági mentést. Az index hozzáadása röviden zárolja a táblázatot."

#: includes/class-minn-admin-db.php:867
msgid "Auto-increment headroom"
msgstr "Automatikus növekmény tartalék"

#: includes/class-minn-admin-db.php:869
msgid "Healthy"
msgstr "Rendben"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:874
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Ezek a táblázatok az oszloptípusuk által tárolható legnagyobb azonosító 20 százalékán belül vannak. Ha elérik a plafont, új sorok nem írhatók: %s"

#: includes/class-minn-admin-db.php:877
msgid "No table is close to exhausting its id column."
msgstr "Egyik táblázat sem közelíti meg az azonosítóoszlop korlátját."

#: includes/class-minn-admin-db.php:885
msgid "Orphaned post meta"
msgstr "Árva bejegyzés-meta"

#: includes/class-minn-admin-db.php:888
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Ezek a metasorok már nem létező bejegyzésekhez tartoznak. Minden bejegyzés-metát érintő lekérdezésben holt teherként ülnek."

#: includes/class-minn-admin-db.php:889
msgid "Every meta row belongs to a post that still exists."
msgstr "Minden metasor létező bejegyzéshez tartozik."

#: includes/class-minn-admin-db.php:891
#: includes/class-minn-admin-db.php:909
#: includes/class-minn-admin-db.php:927
msgid "Delete them"
msgstr "Töröld őket"

#: includes/class-minn-admin-db.php:893
#: includes/class-minn-admin-db.php:911
#: includes/class-minn-admin-db.php:929
msgid "Back up first. This permanently deletes rows."
msgstr "Először készíts biztonsági mentést. Ez véglegesen törli a sorokat."

#: includes/class-minn-admin-db.php:903
msgid "Orphaned user meta"
msgstr "Árva felhasználó-meta"

#: includes/class-minn-admin-db.php:906
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Ezek a metasorok már nem létező felhasználókhoz tartoznak, általában egy fiókokat közvetlenül törlő bővítmény hagyta őket hátra."

#: includes/class-minn-admin-db.php:907
msgid "Every meta row belongs to a user who still exists."
msgstr "Minden metasor létező felhasználóhoz tartozik."

#: includes/class-minn-admin-db.php:921
msgid "Orphaned term relationships"
msgstr "Árva kifejezéskapcsolatok"

#: includes/class-minn-admin-db.php:924
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Ezek a sorok már nem létező kategóriákhoz vagy címkékhez kapcsolják a tartalmat."

#: includes/class-minn-admin-db.php:925
msgid "Every relationship points at a term that still exists."
msgstr "Minden kapcsolat létező kifejezésre mutat."

#: includes/class-minn-admin-db.php:939
msgid "Stored revisions"
msgstr "Tárolt változatok"

#: includes/class-minn-admin-db.php:942
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "A változatok a szerkesztő védőhálója, ezért a nagy szám normális, nem hiba. Csak akkor érdemes nyírni őket, ha a bejegyzések táblázata már kezelhetetlenül megnőtt."

#: includes/class-minn-admin-db.php:943
msgid "No revisions are stored."
msgstr "Nincsenek tárolt változatok."

#: includes/class-minn-admin-db.php:945
msgid "Delete all revisions"
msgstr "Összes változat törlése"

#: includes/class-minn-admin-db.php:947
msgid "Back up first. This removes every saved revision permanently."
msgstr "Először készíts biztonsági mentést. Ez véglegesen eltávolít minden mentett változatot."

#: includes/class-minn-admin-db.php:957
msgid "Spam and trashed comments"
msgstr "Spam és lomtárban lévő hozzászólások"

#: includes/class-minn-admin-db.php:960
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "A spam és lomtárban lévő hozzászólások addig maradnak az adatbázisban, amíg ki nem ürítik őket. A WordPress egy idő után magától törli őket."

#: includes/class-minn-admin-db.php:961
msgid "No spam or trashed comments are waiting."
msgstr "Nincs várakozó spam vagy lomtárban lévő hozzászólás."

#: includes/class-minn-admin-db.php:963
msgid "Delete spam"
msgstr "Spam törlése"

#: includes/class-minn-admin-db.php:965
msgid "Back up first. This permanently deletes the comments."
msgstr "Először készíts biztonsági mentést. Ez véglegesen törli a hozzászólásokat."

#: includes/class-minn-admin-db.php:976
msgid "Expired WooCommerce sessions"
msgstr "Lejárt WooCommerce munkamenetek"

#: includes/class-minn-admin-db.php:979
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "A lejárt kosármunkameneteket egy időzített WooCommerce feladatnak kellene törölnie. A nagy hátralék általában azt jelenti, hogy a feladat nem fut."

#: includes/class-minn-admin-db.php:980
msgid "No expired sessions are left behind."
msgstr "Nincs hátrahagyott lejárt munkamenet."

#: includes/class-minn-admin-db.php:982
msgid "Delete expired sessions"
msgstr "Lejárt munkamenetek törlése"

#: includes/class-minn-admin-db.php:984
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Először készíts biztonsági mentést. A lejárt kosárral rendelkező vásárlók elveszítik azt, ami definíció szerint már megtörtént."

#: includes/class-minn-admin-db.php:995
msgid "Action Scheduler backlog"
msgstr "Action Scheduler hátralék"

#: includes/class-minn-admin-db.php:998
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Függőben lévő és sikertelen háttérfeladatok. A folyamatos hátralék egy forgalmas boltban normális; a nagyon nagy arra utal, hogy a sor nem ürül."

#: includes/class-minn-admin-db.php:999
msgid "No pending or failed background jobs."
msgstr "Nincs függőben lévő vagy sikertelen háttérfeladat."

#: includes/class-minn-admin-db.php:1001
msgid "Clean the queue"
msgstr "Sor tisztítása"

#: includes/class-minn-admin-db.php:1003
msgid "Removes finished actions. Pending work is left alone."
msgstr "A befejezett műveleteket eltávolítja. A függőben lévő munka érintetlen marad."

#: includes/class-minn-admin-logs.php:93
msgid "PHP error log"
msgstr "PHP hibanapló"

#: includes/class-minn-admin-logs.php:93
#: includes/class-minn-admin-rest.php:8210
msgid "Server"
msgstr "Kiszolgáló"

#: includes/class-minn-admin-logs.php:171
#: includes/class-minn-admin-logs.php:196
msgid "Unknown log source."
msgstr "Ismeretlen naplóforrás."

#: includes/class-minn-admin-logs.php:176
msgid "Could not read this log."
msgstr "Ezt a naplót nem sikerült beolvasni."

#: includes/class-minn-admin-logs.php:199
msgid "This log cannot be cleared from here."
msgstr "Ez a napló innen nem törölhető."

#: includes/class-minn-admin-logs.php:204
#: includes/class-minn-admin-logs.php:297
msgid "Could not clear the log."
msgstr "A naplót nem sikerült törölni."

#: includes/class-minn-admin-logs.php:227
msgid "This log lives outside the site, so Minn does not read it."
msgstr "Ez a napló a webhelyen kívül van, ezért a Minn nem olvassa."

#: includes/class-minn-admin-logs.php:293
msgid "This log is not writable."
msgstr "Ez a napló nem írható."

#: includes/class-minn-admin-notices.php:400
#: assets/js/app.js:5603
#: assets/js/app.js:15236
#: assets/js/app.js:37613
msgid "Open"
msgstr "Megnyitás"

#: includes/class-minn-admin-notices.php:632
msgid "That notice action is not supported."
msgstr "Ez az értesítési művelet nem támogatott."

#: includes/class-minn-admin-notices.php:642
msgid "That notice action does not declare a capability."
msgstr "Ez az értesítési művelet nem ad meg jogosultságot."

#: includes/class-minn-admin-notices.php:645
msgid "You cannot run that notice action."
msgstr "Ezt az értesítési műveletet nem futtathatod."

#: includes/class-minn-admin-notices.php:665
msgid "You cannot dismiss this notice."
msgstr "Ezt az értesítést nem zárhatod be."

#: includes/class-minn-admin-notices.php:684
msgid "You cannot answer this notice."
msgstr "Erre az értesítésre nem válaszolhatsz."

#: includes/class-minn-admin-rest.php:414
msgid "Invalid notice id."
msgstr "Hibás értesítésazonosító."

#: includes/class-minn-admin-rest.php:1778
msgid "Whether an autosave newer than the saved post exists (live post carrying unsaved edits)."
msgstr "Van-e a mentett bejegyzésnél újabb automatikus mentés (éles bejegyzés mentetlen szerkesztésekkel)."

#: includes/class-minn-admin-rest.php:1822
msgid "The other user currently editing this post (core edit lock), or null."
msgstr "A másik felhasználó, aki jelenleg szerkeszti ezt a bejegyzést (alap zárolás), vagy null."

