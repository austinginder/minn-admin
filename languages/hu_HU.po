#: includes/class-minn-admin-rest.php:8005
msgid "Fonts must be one of the families the theme (or Font Library) provides."
msgstr "A betűtípusoknak a sablon (vagy a Betűtípuskönyvtár) által biztosított családok egyikének kell lenniük."

#: includes/class-minn-admin-rest.php:8013
msgid "Text sizes take a preset or a CSS length such as 18px or 1.125rem."
msgstr "A szövegméretek előbeállítást vagy CSS-hosszt vehetnek fel, például 18px vagy 1.125rem."

#: includes/class-minn-admin-rest.php:8018
msgid "Line height takes a number such as 1.6."
msgstr "A sormagasság számot vesz fel, például 1.6."

#: includes/class-minn-admin-rest.php:8026
msgid "Widths and spacing take a CSS length such as 24px, 1.5rem or 5%."
msgstr "A szélességek és a térköz CSS-hosszt vesznek fel, például 24px, 1.5rem vagy 5%."

#: includes/class-minn-admin-rest.php:8028
msgid "Unsupported value."
msgstr "Nem támogatott érték."

#: includes/class-minn-admin-rest.php:8094
msgid "Nothing to change."
msgstr "Nincs mit változtatni."

