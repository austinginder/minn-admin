msgstr "Ez a beállítás a bővítmény saját képernyőjén fut."

#: includes/class-minn-admin-rest.php:2701
msgid "The plugin reported an error during setup."
msgstr "A bővítmény hibát jelzett a beállítás során."

#: includes/class-minn-admin-rest.php:2756
