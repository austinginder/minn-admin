msgstr "Az egyéni szerkezethez legalább egy címke kell, pl. %postname%."

#: includes/class-minn-admin-rest.php:3718
msgid "The custom CSS was changed somewhere else after you opened it. Copy your edit, reload, and apply it again."
msgstr "Az egyéni CSS-t máshol megváltoztatták, miután megnyitottad. Másold ki a módosításodat, töltsd újra az oldalt, majd alkalmazd ismét."

#: includes/class-minn-admin-rest.php:3735
msgid "curly brackets"
msgstr "kapcsos zárójelek"

#: includes/class-minn-admin-rest.php:3736
msgid "parentheses"
msgstr "kerek zárójelek"

#: includes/class-minn-admin-rest.php:3737
msgid "square brackets"
msgstr "szögletes zárójelek"

#. translators: %s: the bracket type that is unbalanced (e.g. "curly brackets").
#: includes/class-minn-admin-rest.php:3742
msgid "That CSS has unbalanced %s. Fix it and save again; nothing was changed."
msgstr "Ebben a CSS-ben a(z) %s nincsenek párban. Javítsd, és mentsd újra; semmi sem változott."

#: includes/class-minn-admin-rest.php:3746
msgid "That CSS has an unclosed comment. Fix it and save again; nothing was changed."
msgstr "Ebben a CSS-ben van egy lezáratlan megjegyzés. Javítsd, és mentsd újra; semmi sem változott."

#. translators: 1: the window's first day (e.g. "Jun 3"). 2: its last day with the year (e.g. "Jul 2, 2026").
#: includes/class-minn-admin-rest.php:3812
msgid "%1$s – %2$s"
msgstr "%1$s – %2$s"

#. translators: %s: the date the week starts on (e.g. "Jun 3, 2026").
#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:3815
#: includes/class-minn-admin-rest.php:4211
#: includes/class-minn-admin-rest.php:5095
