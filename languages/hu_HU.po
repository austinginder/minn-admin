msgstr "Ehhez a hozzászóláshoz nincs tiltandó e-mail vagy IP."

#. translators: 1: author display name, 2: post title.
#: includes/class-minn-admin-rest.php:2131
#: includes/class-minn-admin-rest.php:3388
#: includes/class-minn-admin-rest.php:3575
msgid "Someone"
msgstr "Valaki"

#: includes/class-minn-admin-rest.php:2215
msgid "That log lives outside this site, so Minn will not clear it."
msgstr "Ez a napló a webhelyen kívül van, ezért a Minn nem törli."

#: includes/class-minn-admin-rest.php:2223
msgid "The debug log is not writable."
msgstr "A hibakeresési napló nem írható."

#: includes/class-minn-admin-rest.php:2227
msgid "Could not clear the debug log."
msgstr "A hibakeresési naplót nem sikerült törölni."

#: includes/class-minn-admin-rest.php:2250
msgid "That block does not offer image editing here."
msgstr "Ez a blokk itt nem kínál képszerkesztést."

#: includes/class-minn-admin-rest.php:2271
msgid "Pick at least one image."
msgstr "Válassz ki legalább egy képet."

#: includes/class-minn-admin-rest.php:2280
msgid "That block could not be rebuilt for those images."
msgstr "A blokkot nem sikerült újraépíteni ezekhez a képekhez."

#: includes/class-minn-admin-rest.php:2288
msgid "Expected an array of block markup strings."
msgstr "Blokkjelölő karakterláncok tömbje volt várható."

#: includes/class-minn-admin-rest.php:2510
msgid "That surface has no setup to run."
msgstr "Ennek a felületnek nincs futtatható beállítása."

#: includes/class-minn-admin-rest.php:2514
msgid "You cannot set up this plugin."
msgstr "Ezt a bővítményt nem állíthatod be."

#: includes/class-minn-admin-rest.php:2518
msgid "This setup runs on the plugin's own screen."
msgstr "Ez a beállítás a bővítmény saját képernyőjén fut."

#: includes/class-minn-admin-rest.php:2538
msgid "The plugin reported an error during setup."
msgstr "A bővítmény hibát jelzett a beállítás során."

#: includes/class-minn-admin-rest.php:2593
msgid "Pattern not found."
msgstr "A minta nem található."

#: includes/class-minn-admin-rest.php:2629
msgid "A custom structure needs at least one tag, e.g. %postname%."
msgstr "Az egyéni szerkezethez legalább egy címke kell, pl. %postname%."

