msgstr "Требуется тема."

#: includes/class-minn-admin-rest.php:11884
#: assets/js/app.js:53553
msgid "Changes"
msgstr "Изменения"

#: includes/class-minn-admin-rest.php:11899
msgid "Plugin slug is required."
