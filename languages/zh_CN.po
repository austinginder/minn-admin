msgid "Add the index"
msgstr "添加索引"

#: includes/class-minn-admin-db.php:1930
msgid "Back up first. Adding an index locks the table briefly."
msgstr "请先备份。添加索引会短暂锁定表格。"

#: includes/class-minn-admin-db.php:1974
msgid "Auto-increment headroom"
msgstr "自增余量"

#: includes/class-minn-admin-db.php:1976
msgid "Healthy"
msgstr "健康"

