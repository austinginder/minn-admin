# The source has no exclamation, and an opening ¡ with no closing ! is broken
# Spanish either way.
msgid "No activity yet."
msgstr "Todavía no hay actividad."

# WordPress core's Spanish string uses the invalid placeholder "%1s". Keep
# the numbered placeholder intact so sprintf receives every argument.
#, php-format
msgid ""
"Hi,\n"
"\n"
"You've been invited to join '%1$s' at\n"
"%2$s with the role of %3$s.\n"
"\n"
"Please click the following link to confirm the invite:\n"
"%4$s"
msgstr ""
"Hola,\n"
"\n"
"Te han invitado a unirte a '%1$s' en\n"
"%2$s con el rol de %3$s.\n"
"\n"
"Haz clic en el siguiente enlace para confirmar la invitación:\n"
"%4$s"
