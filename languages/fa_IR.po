msgstr "ACF نتوانست گونه نوشته را ذخیره کند."

#: includes/class-minn-admin-cpt.php:1777
#: includes/class-minn-admin-cpt.php:1780
msgid "JetEngine could not save the post type."
msgstr "JetEngine نتوانست گونه نوشته را ذخیره کند."

#: includes/class-minn-admin-cpt.php:1844
#: includes/class-minn-admin-cpt.php:1847
