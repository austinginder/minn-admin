#: includes/class-minn-admin-rest.php:2854
msgid "That CSS has unbalanced %s. Fix it and save again; nothing was changed."
msgstr "این CSS دارای %s نامتوازن است. آن را درست کنید و دوباره ذخیره کنید؛ چیزی تغییر نکرد."

#: includes/class-minn-admin-rest.php:2858
msgid "That CSS has an unclosed comment. Fix it and save again; nothing was changed."
msgstr "این CSS یک توضیح بسته‌نشده دارد. آن را درست کنید و دوباره ذخیره کنید؛ چیزی تغییر نکرد."

#. translators: 1: the window's first day (e.g. "Jun 3"). 2: its last day with the year (e.g. "Jul 2, 2026").
#: includes/class-minn-admin-rest.php:2924
msgid "%1$s – %2$s"
msgstr "%1$s – %2$s"

#. translators: %s: the date the week starts on (e.g. "Jun 3, 2026").
#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:2927
#: includes/class-minn-admin-rest.php:3324
msgid "Week of %s"
msgstr "هفته %s"

#: includes/class-minn-admin-rest.php:2962
#: includes/class-minn-admin-rest.php:3047
#: includes/class-minn-admin-rest.php:4094
msgid "from must be on or before to."
msgstr "«از» باید برابر یا پیش از «تا» باشد."

#: includes/class-minn-admin-rest.php:2974
msgid "Custom ranges reach back two years at most."
msgstr "بازه‌های سفارشی حداکثر تا دو سال عقب می‌روند."

#: includes/class-minn-admin-rest.php:2977
#: includes/class-minn-admin-rest.php:3051
msgid "Pick a window of a year or less."
msgstr "بازه‌ای یک‌ساله یا کوتاه‌تر انتخاب کنید."

#: includes/class-minn-admin-rest.php:3197
#: includes/class-minn-admin-rest.php:3550
msgid "Published posts"
msgstr "نوشته‌های منتشرشده"

#. translators: %s: number of draft posts.
#. translators: %s: number of draft products.
#: includes/class-minn-admin-rest.php:3203
#: includes/class-minn-admin-rest.php:3556
#: includes/class-minn-admin-rest.php:3774
msgid "%s draft"
