#. translators: %s: number of draft products.
#: includes/class-minn-admin-rest.php:3198
#: includes/class-minn-admin-rest.php:3551
#: includes/class-minn-admin-rest.php:3769
msgid "%s draft"
msgid_plural "%s drafts"
