msgid "(no title)"
msgstr "(بدون عنوان)"

#: includes/class-minn-admin-rest.php:2072
msgid "Comment not found."
msgstr "دیدگاه پیدا نشد."

#: includes/class-minn-admin-rest.php:2079
msgid "This comment carries no email or IP to block."
msgstr "این دیدگاه ایمیل یا IP برای مسدود کردن ندارد."

