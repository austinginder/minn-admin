msgid "Unknown log source."
msgstr "منبع گزارش ناشناخته."

#: includes/class-minn-admin-logs.php:180
msgid "Could not read this log."
msgstr "این گزارش خوانده نشد."

#: includes/class-minn-admin-logs.php:203
msgid "This log cannot be cleared from here."
msgstr "این گزارش از اینجا پاکسازی نمی‌شود."

#: includes/class-minn-admin-logs.php:208
#: includes/class-minn-admin-logs.php:301
msgid "Could not clear the log."
msgstr "گزارش پاکسازی نشد."

#: includes/class-minn-admin-logs.php:231
msgid "This log lives outside the site, so Minn does not read it."
msgstr "این گزارش بیرون از سایت است، بنابراین Minn آن را نمی‌خواند."

#: includes/class-minn-admin-logs.php:297
msgid "This log is not writable."
msgstr "این گزارش قابل نوشتن نیست."

#: includes/class-minn-admin-notices.php:742
#: assets/js/app.js:7188
#: assets/js/app.js:19105
#: assets/js/app.js:49441
msgid "Open"
msgstr "باز کردن"

#: includes/class-minn-admin-notices.php:987
msgid "That notice action is not supported."
msgstr "این عمل پیام پشتیبانی نمی‌شود."

#: includes/class-minn-admin-notices.php:997
msgid "That notice action does not declare a capability."
msgstr "این عمل پیام هیچ توانایی‌ای اعلام نمی‌کند."

#: includes/class-minn-admin-notices.php:1000
msgid "You cannot run that notice action."
msgstr "شما نمی‌توانید این عمل پیام را اجرا کنید."

#: includes/class-minn-admin-notices.php:1020
msgid "You cannot dismiss this notice."
msgstr "شما نمی‌توانید این پیام را لغو کنید."

#: includes/class-minn-admin-notices.php:1039
msgid "You cannot answer this notice."
msgstr "شما نمی‌توانید به این پیام پاسخ دهید."

#: includes/class-minn-admin-plugin-links.php:361
msgid "Spam settings"
msgstr "تنظیمات جفنگ"

#: includes/class-minn-admin-plugin-links.php:368
#: assets/js/app.js:976
#: assets/js/app.js:39285
#: assets/js/app.js:39287
#: assets/js/app.js:50108
#: assets/js/app.js:56077
msgid "Visibility"
msgstr "قابلیت مشاهده"

#: includes/class-minn-admin-plugin-links.php:372
