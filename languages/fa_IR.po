msgid "Week of %s"
msgstr "هفته %s"

#: includes/class-minn-admin-rest.php:2957
#: includes/class-minn-admin-rest.php:3042
#: includes/class-minn-admin-rest.php:4089
msgid "from must be on or before to."
msgstr "«از» باید برابر یا پیش از «تا» باشد."

#: includes/class-minn-admin-rest.php:2969
msgid "Custom ranges reach back two years at most."
msgstr "بازه‌های سفارشی حداکثر تا دو سال عقب می‌روند."

#: includes/class-minn-admin-rest.php:2972
#: includes/class-minn-admin-rest.php:3046
msgid "Pick a window of a year or less."
msgstr "بازه‌ای یک‌ساله یا کوتاه‌تر انتخاب کنید."

#: includes/class-minn-admin-rest.php:3192
#: includes/class-minn-admin-rest.php:3545
msgid "Published posts"
msgstr "نوشته‌های منتشرشده"

