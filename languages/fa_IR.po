msgid "That log lives outside this site, so Minn will not clear it."
msgstr "آن گزارش بیرون از این سایت است، بنابراین Minn آن را پاک نمی‌کند."

#: includes/class-minn-admin-rest.php:2642
msgid "The debug log is not writable."
msgstr "گزارش اشکال‌زدایی قابل نوشتن نیست."

#: includes/class-minn-admin-rest.php:2646
msgid "Could not clear the debug log."
msgstr "گزارش اشکال‌زدایی پاکسازی نشد."

#: includes/class-minn-admin-rest.php:2669
msgid "That block does not offer image editing here."
msgstr "این بلوک اینجا ویرایش تصویر ارائه نمی‌دهد."

#: includes/class-minn-admin-rest.php:2678
msgid "One of those images cannot be used here."
msgstr "یکی از این تصویرها را نمی‌توان اینجا به کار برد."

#: includes/class-minn-admin-rest.php:2692
msgid "Pick at least one image."
msgstr "دست‌کم یک تصویر برگزینید."

#: includes/class-minn-admin-rest.php:2701
msgid "That block could not be rebuilt for those images."
msgstr "این بلوک برای آن تصاویر بازسازی نشد."

#: includes/class-minn-admin-rest.php:2762
msgid "Expected an array of block markup strings."
msgstr "آرایه‌ای از رشته‌های نشانه‌گذاری بلوک انتظار می‌رفت."

#: includes/class-minn-admin-rest.php:3059
#: includes/class-minn-admin-rest.php:3084
msgid "That surface has no setup to run."
msgstr "این بخش راه‌اندازی‌ای برای اجرا ندارد."

#: includes/class-minn-admin-rest.php:3087
msgid "This setup runs on the plugin's own screen."
msgstr "این راه‌اندازی در صفحه خود افزونه انجام می‌شود."

#: includes/class-minn-admin-rest.php:3107
msgid "The plugin reported an error during setup."
msgstr "افزونه هنگام راه‌اندازی خطایی گزارش کرد."

#: includes/class-minn-admin-rest.php:3162
msgid "Pattern not found."
msgstr "الگو پیدا نشد."

#: includes/class-minn-admin-rest.php:3198
msgid "A custom structure needs at least one tag, e.g. %postname%."
msgstr "یک ساختار سفارشی دست‌کم به یک تگ نیاز دارد، برای نمونه %postname%."

#: includes/class-minn-admin-rest.php:3246
msgid "curly brackets"
msgstr "آکولادها"

#: includes/class-minn-admin-rest.php:3247
msgid "parentheses"
msgstr "پرانتزها"

#: includes/class-minn-admin-rest.php:3248
msgid "square brackets"
msgstr "کروشه‌ها"

#. translators: %s: the bracket type that is unbalanced (e.g. "curly brackets").
#: includes/class-minn-admin-rest.php:3253
msgid "That CSS has unbalanced %s. Fix it and save again; nothing was changed."
msgstr "این CSS دارای %s نامتوازن است. آن را درست کنید و دوباره ذخیره کنید؛ چیزی تغییر نکرد."

#: includes/class-minn-admin-rest.php:3257
msgid "That CSS has an unclosed comment. Fix it and save again; nothing was changed."
msgstr "این CSS یک توضیح بسته‌نشده دارد. آن را درست کنید و دوباره ذخیره کنید؛ چیزی تغییر نکرد."

#. translators: 1: the window's first day (e.g. "Jun 3"). 2: its last day with the year (e.g. "Jul 2, 2026").
#: includes/class-minn-admin-rest.php:3323
msgid "%1$s – %2$s"
msgstr "%1$s – %2$s"

#. translators: %s: the date the week starts on (e.g. "Jun 3, 2026").
#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:3326
#: includes/class-minn-admin-rest.php:3722
msgid "Week of %s"
msgstr "هفته %s"

#: includes/class-minn-admin-rest.php:3361
#: includes/class-minn-admin-rest.php:3446
#: includes/class-minn-admin-rest.php:4494
msgid "from must be on or before to."
msgstr "«از» باید برابر یا پیش از «تا» باشد."

#: includes/class-minn-admin-rest.php:3373
msgid "Custom ranges reach back two years at most."
