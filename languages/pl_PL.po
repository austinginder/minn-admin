msgstr "To działanie powiadomienia nie jest obsługiwane."

#: includes/class-minn-admin-notices.php:1001
msgid "That notice action does not declare a capability."
msgstr "To działanie powiadomienia nie deklaruje uprawnienia."

#: includes/class-minn-admin-notices.php:1004
msgid "You cannot run that notice action."
msgstr "Brak uprawnień do wykonania tego działania."

#: includes/class-minn-admin-notices.php:1024
msgid "You cannot dismiss this notice."
msgstr "Brak uprawnień do odrzucenia tego powiadomienia."

#: includes/class-minn-admin-notices.php:1043
msgid "You cannot answer this notice."
msgstr "Brak uprawnień do odpowiedzi na to powiadomienie."

#: includes/class-minn-admin-plugin-links.php:361
msgid "Spam settings"
msgstr "Ustawienia spamu"

#: includes/class-minn-admin-plugin-links.php:368
#: assets/js/app.js:969
#: assets/js/app.js:39258
#: assets/js/app.js:39260
#: assets/js/app.js:50070
#: assets/js/app.js:56036
