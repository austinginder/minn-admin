msgstr[2] "%s kontroli bazy danych wymaga uwagi"

#: includes/class-minn-admin-db.php:658
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Osierocone wiersze, indeksy i silniki wyglądają dobrze"

#: includes/class-minn-admin-db.php:725
msgid "Tables without a primary key"
msgstr "Tabele bez klucza głównego"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:731
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Te tabele nie mają klucza głównego, co psuje replikację na poziomie wierszy i myli narzędzia do kopii i migracji: %s"

#: includes/class-minn-admin-db.php:734
msgid "Every table has a primary key."
msgstr "Każda tabela ma klucz główny."

#: includes/class-minn-admin-db.php:746
msgid "Storage engine"
msgstr "Silnik składowania"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:752
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Te tabele nie używają InnoDB, więc nie mają blokowania wierszy ani odzyskiwania po awarii: %s"

#: includes/class-minn-admin-db.php:755
msgid "Every table uses InnoDB."
msgstr "Każda tabela używa InnoDB."

#: includes/class-minn-admin-db.php:757
msgid "Convert a table"
msgstr "Konwertuj tabelę"

#: includes/class-minn-admin-db.php:759
msgid "Back up first. Converting locks the table while it runs."
msgstr "Najpierw zrób kopię. Konwersja blokuje tabelę na czas działania."

#: includes/class-minn-admin-db.php:778
msgid "Reclaimable space"
msgstr "Miejsce do odzyskania"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:785
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Sama tabela %1$s trzyma %2$s wolnego miejsca we własnym pliku. Optymalizacja przepisuje tabelę i zwraca je na dysk."

#: includes/class-minn-admin-db.php:789
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Żadna tabela nie trzyma znaczącej ilości miejsca do odzyskania."

#: includes/class-minn-admin-db.php:791
msgid "Optimise tables"
msgstr "Optymalizuj tabele"

#: includes/class-minn-admin-db.php:793
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Najpierw zrób kopię. Optymalizacja blokuje każdą tabelę na czas działania."

#: includes/class-minn-admin-db.php:811
msgid "Post meta lookup index"
msgstr "Indeks wyszukiwania meta wpisów"

#: includes/class-minn-admin-db.php:814
msgid "Present"
msgstr "Obecny"

#: includes/class-minn-admin-db.php:816
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Złożony indeks post_id i meta_key istnieje, więc wyszukiwanie meta jest szybkie."

#: includes/class-minn-admin-db.php:817
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Wyszukiwanie po wpisie i kluczu meta korzysta z dwóch osobnych indeksów. Na witrynach intensywnie używających meta (WooCommerce, wtyczki wydarzeń i rezerwacji) złożony indeks daje duży i bezpieczny zysk szybkości."

#: includes/class-minn-admin-db.php:819
msgid "Add the index"
msgstr "Dodaj indeks"

#: includes/class-minn-admin-db.php:821
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Najpierw zrób kopię. Dodanie indeksu na chwilę blokuje tabelę."

#: includes/class-minn-admin-db.php:865
msgid "Auto-increment headroom"
msgstr "Zapas auto-inkrementacji"

#: includes/class-minn-admin-db.php:867
msgid "Healthy"
msgstr "W normie"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:872
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Tym tabelom brakuje mniej niż 20 procent do największego ID, jakie pomieści typ kolumny. Po osiągnięciu limitu nowe wiersze przestaną się zapisywać: %s"

#: includes/class-minn-admin-db.php:875
msgid "No table is close to exhausting its id column."
msgstr "Żadna tabela nie zbliża się do wyczerpania kolumny ID."

#: includes/class-minn-admin-db.php:883
msgid "Orphaned post meta"
msgstr "Osierocone meta wpisów"

#: includes/class-minn-admin-db.php:886
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Te wiersze meta należą do wpisów, które już nie istnieją. To zbędny balast w każdym zapytaniu o meta wpisów."

#: includes/class-minn-admin-db.php:887
msgid "Every meta row belongs to a post that still exists."
msgstr "Każdy wiersz meta należy do istniejącego wpisu."

#: includes/class-minn-admin-db.php:889
#: includes/class-minn-admin-db.php:907
#: includes/class-minn-admin-db.php:925
msgid "Delete them"
msgstr "Usuń je"

#: includes/class-minn-admin-db.php:891
#: includes/class-minn-admin-db.php:909
#: includes/class-minn-admin-db.php:927
msgid "Back up first. This permanently deletes rows."
msgstr "Najpierw zrób kopię. To trwale usuwa wiersze."

#: includes/class-minn-admin-db.php:901
msgid "Orphaned user meta"
msgstr "Osierocone meta użytkowników"

#: includes/class-minn-admin-db.php:904
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Te wiersze meta należą do użytkowników, którzy już nie istnieją — zwykle zostawia je wtyczka usuwająca konta bezpośrednio."

#: includes/class-minn-admin-db.php:905
msgid "Every meta row belongs to a user who still exists."
msgstr "Każdy wiersz meta należy do istniejącego użytkownika."

#: includes/class-minn-admin-db.php:919
msgid "Orphaned term relationships"
msgstr "Osierocone relacje terminów"

#: includes/class-minn-admin-db.php:922
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Te wiersze łączą treść z kategoriami lub tagami, które już nie istnieją."

#: includes/class-minn-admin-db.php:923
msgid "Every relationship points at a term that still exists."
msgstr "Każda relacja wskazuje istniejący termin."

#: includes/class-minn-admin-db.php:937
msgid "Stored revisions"
msgstr "Zapisane wersje"

#: includes/class-minn-admin-db.php:940
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Wersje to siatka bezpieczeństwa edytora, więc ich duża liczba jest normalna. Przycinanie ma sens tylko wtedy, gdy tabela wpisów zrobiła się nieporęczna."

#: includes/class-minn-admin-db.php:941
msgid "No revisions are stored."
msgstr "Nie zapisano żadnych wersji."

#: includes/class-minn-admin-db.php:943
msgid "Delete all revisions"
msgstr "Usuń wszystkie wersje"

#: includes/class-minn-admin-db.php:945
msgid "Back up first. This removes every saved revision permanently."
msgstr "Najpierw zrób kopię. To trwale usuwa wszystkie zapisane wersje."

#: includes/class-minn-admin-db.php:955
msgid "Spam and trashed comments"
msgstr "Komentarze w spamie i koszu"

#: includes/class-minn-admin-db.php:958
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Komentarze w spamie i koszu zostają w bazie do czasu opróżnienia. WordPress sam czyści je po pewnym czasie."

#: includes/class-minn-admin-db.php:959
msgid "No spam or trashed comments are waiting."
msgstr "Nie czekają żadne komentarze w spamie ani koszu."

#: includes/class-minn-admin-db.php:961
msgid "Delete spam"
msgstr "Usuń spam"

#: includes/class-minn-admin-db.php:963
msgid "Back up first. This permanently deletes the comments."
msgstr "Najpierw zrób kopię. To trwale usuwa komentarze."

#: includes/class-minn-admin-db.php:974
msgid "Expired WooCommerce sessions"
msgstr "Wygasłe sesje WooCommerce"

#: includes/class-minn-admin-db.php:977
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Wygasłe sesje koszyka powinno czyścić zaplanowane zadanie WooCommerce. Duże zaległości zwykle znaczą, że zadanie przestało działać."

#: includes/class-minn-admin-db.php:978
msgid "No expired sessions are left behind."
msgstr "Nie zostały żadne wygasłe sesje."

#: includes/class-minn-admin-db.php:980
msgid "Delete expired sessions"
msgstr "Usuń wygasłe sesje"

#: includes/class-minn-admin-db.php:982
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Najpierw zrób kopię. Kupujący z wygasłym koszykiem go tracą, co z definicji już nastąpiło."

#: includes/class-minn-admin-db.php:993
msgid "Action Scheduler backlog"
msgstr "Zaległości Action Scheduler"

#: includes/class-minn-admin-db.php:996
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Oczekujące i nieudane zadania w tle. Stałe zaległości są normalne w ruchliwym sklepie; bardzo duże sugerują, że kolejka się nie opróżnia."

#: includes/class-minn-admin-db.php:997
msgid "No pending or failed background jobs."
msgstr "Brak oczekujących i nieudanych zadań w tle."

#: includes/class-minn-admin-db.php:999
msgid "Clean the queue"
msgstr "Wyczyść kolejkę"

#: includes/class-minn-admin-db.php:1001
msgid "Removes finished actions. Pending work is left alone."
msgstr "Usuwa zakończone działania. Oczekujące pozostają nietknięte."

