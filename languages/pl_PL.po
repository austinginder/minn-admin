#: includes/class-minn-admin-switch.php:592
msgid "That switch is not known here."
msgstr "To przełączenie nie jest tu znane."

#: includes/class-minn-admin-switch.php:703
msgid "Preflight is RED, so the site stays on WordPress. Pass --force to install anyway."
msgstr "Kontrola wstępna ma wynik RED, więc witryna pozostaje na WordPressie. Użyj --force, aby mimo to zainstalować."

#. translators: %s: a folder path.
#: includes/class-minn-admin-switch.php:709
msgid "Cannot put WordPress's own files in %s: it is not writable, or not empty. Choose a folder outside the site with --park=<dir>."
msgstr "Nie można umieścić własnych plików WordPressa w %s: katalog nie jest zapisywalny lub nie jest pusty. Wybierz katalog poza witryną za pomocą --park=<dir>."

#. translators: 1: Minn's version, 2: the WordPress version Minn speaks, 3: the WordPress version this site runs.
#: includes/class-minn-admin-switch.php:713
#: assets/js/app.js:28543
