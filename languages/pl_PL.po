msgstr "Archiwum zawiera Minn %1$s, a nie %2$s z nazwy wydania, więc nie jest używane."

#. translators: 1: a Minn version, 2: the oldest Minn version Minn Admin installs.
#: includes/class-minn-admin-switch.php:280
msgid "Minn %1$s is older than Minn %2$s, the oldest release Minn Admin installs, so it is not used."
msgstr "Minn %1$s jest starszy niż Minn %2$s, najstarsze wydanie, które instaluje Minn Admin, więc nie jest używany."

#: includes/class-minn-admin-switch.php:316
msgid "This Minn release is older than Minn Admin can install from WordPress; use its install.sh instead."
msgstr "To wydanie Minn jest zbyt stare, aby Minn Admin mógł je zainstalować z poziomu WordPressa; użyj zamiast tego dołączonego pliku install.sh."

#: includes/class-minn-admin-switch.php:523
msgid "That check has expired. Check the site again."
msgstr "To sprawdzenie wygasło. Sprawdź witrynę ponownie."

