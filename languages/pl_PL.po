#: includes/class-minn-admin-rest.php:8055
msgid "Text sizes take a preset or a CSS length such as 18px or 1.125rem."
msgstr "Rozmiary tekstu przyjmują ustawienie wstępne lub długość CSS, np. 18px albo 1.125rem."

