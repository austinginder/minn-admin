msgstr "Widoczność"

#: includes/class-minn-admin-plugin-links.php:372
#: assets/js/app.js:1460
#: assets/js/app.js:4162
msgid "Store settings"
msgstr "Ustawienia sklepu"

#: includes/class-minn-admin-plugin-links.php:385
