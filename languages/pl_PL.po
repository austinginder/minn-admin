msgstr "[tag: %s]"

#: includes/class-minn-admin-rest.php:534
msgid "Invalid notice id."
msgstr "Nieprawidłowe ID powiadomienia."

#: includes/class-minn-admin-rest.php:1422
msgid "Link to the payment in the payment provider's dashboard, as the order screen shows it."
msgstr "Odnośnik do płatności w kokpicie dostawcy płatności, tak jak pokazuje go ekran zamówienia."

#: includes/class-minn-admin-rest.php:2222
msgid "Whether an autosave newer than the saved post exists (live post carrying unsaved edits)."
msgstr "Czy istnieje automatyczny zapis nowszy niż zapisany wpis (opublikowany wpis z niezapisanymi zmianami)."

#: includes/class-minn-admin-rest.php:2270
msgid "The other user currently editing this post (core edit lock), or null."
msgstr "Inny użytkownik obecnie edytujący ten wpis (blokada edycji rdzenia) lub null."

#. translators: 1: author display name, 2: post title.
#: includes/class-minn-admin-rest.php:2540
#: includes/class-minn-admin-rest.php:5105
#: includes/class-minn-admin-rest.php:5320
msgid "Someone"
msgstr "Ktoś"

#: includes/class-minn-admin-rest.php:2585
msgid "That log lives outside this site, so Minn will not clear it."
msgstr "Ten dziennik znajduje się poza tą witryną, więc Minn go nie wyczyści."

#: includes/class-minn-admin-rest.php:2593
msgid "The debug log is not writable."
msgstr "Dziennik debugowania nie jest zapisywalny."

#: includes/class-minn-admin-rest.php:2597
msgid "Could not clear the debug log."
msgstr "Nie udało się wyczyścić dziennika debugowania."

#: includes/class-minn-admin-rest.php:2620
msgid "That block does not offer image editing here."
msgstr "Ten blok nie oferuje tutaj edycji obrazka."

#: includes/class-minn-admin-rest.php:2629
msgid "One of those images cannot be used here."
msgstr "Jednego z tych obrazków nie można tu użyć."

#: includes/class-minn-admin-rest.php:2643
msgid "Pick at least one image."
msgstr "Wybierz co najmniej jeden obrazek."

#: includes/class-minn-admin-rest.php:2652
msgid "That block could not be rebuilt for those images."
msgstr "Nie udało się przebudować tego bloku dla tych obrazków."

#: includes/class-minn-admin-rest.php:2993
msgid "Expected an array of block markup strings."
msgstr "Oczekiwano tablicy ciągów ze znacznikami bloków."

#: includes/class-minn-admin-rest.php:3460
#: includes/class-minn-admin-rest.php:3485
msgid "That surface has no setup to run."
msgstr "Ten obszar nie ma konfiguracji do uruchomienia."

#: includes/class-minn-admin-rest.php:3488
msgid "This setup runs on the plugin's own screen."
msgstr "Ta konfiguracja odbywa się na własnym ekranie wtyczki."

#: includes/class-minn-admin-rest.php:3508
msgid "The plugin reported an error during setup."
msgstr "Wtyczka zgłosiła błąd podczas konfiguracji."

#: includes/class-minn-admin-rest.php:3563
msgid "Pattern not found."
msgstr "Nie znaleziono wzorca."

#: includes/class-minn-admin-rest.php:3634
msgid "A custom structure needs at least one tag, e.g. %postname%."
msgstr "Własna struktura wymaga co najmniej jednego znacznika, np. %postname%."

#: includes/class-minn-admin-rest.php:3705
msgid "The custom CSS was changed somewhere else after you opened it. Copy your edit, reload, and apply it again."
msgstr "Własny CSS został zmieniony w innym miejscu po jego otwarciu. Skopiuj swoją zmianę, wczytaj ponownie i zastosuj ją jeszcze raz."

#: includes/class-minn-admin-rest.php:3722
msgid "curly brackets"
msgstr "nawiasy klamrowe"

#: includes/class-minn-admin-rest.php:3723
msgid "parentheses"
msgstr "nawiasy okrągłe"

#: includes/class-minn-admin-rest.php:3724
msgid "square brackets"
msgstr "nawiasy kwadratowe"

#. translators: %s: the bracket type that is unbalanced (e.g. "curly brackets").
#: includes/class-minn-admin-rest.php:3729
msgid "That CSS has unbalanced %s. Fix it and save again; nothing was changed."
msgstr "Ten CSS ma niezbilansowane %s. Popraw go i zapisz ponownie; nic nie zmieniono."

#: includes/class-minn-admin-rest.php:3733
msgid "That CSS has an unclosed comment. Fix it and save again; nothing was changed."
msgstr "Ten CSS ma niezamknięty komentarz. Popraw go i zapisz ponownie; nic nie zmieniono."

#. translators: 1: the window's first day (e.g. "Jun 3"). 2: its last day with the year (e.g. "Jul 2, 2026").
#: includes/class-minn-admin-rest.php:3799
msgid "%1$s – %2$s"
msgstr "%1$s – %2$s"

#. translators: %s: the date the week starts on (e.g. "Jun 3, 2026").
#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:3802
#: includes/class-minn-admin-rest.php:4198
msgid "Week of %s"
msgstr "Tydzień od %s"

#: includes/class-minn-admin-rest.php:3837
#: includes/class-minn-admin-rest.php:3922
#: includes/class-minn-admin-rest.php:5014
msgid "from must be on or before to."
msgstr "Data „od” musi być wcześniejsza lub równa dacie „do”."

#: includes/class-minn-admin-rest.php:3849
msgid "Custom ranges reach back two years at most."
msgstr "Własne zakresy sięgają wstecz najwyżej dwa lata."

#: includes/class-minn-admin-rest.php:3852
#: includes/class-minn-admin-rest.php:3926
msgid "Pick a window of a year or less."
