msgstr "Nie udało się zapisać kopii zapasowej wp-config.php, więc zmiany nie wprowadzono."

#. translators: %s: the file name of the kept copy of wp-config.php.
#: includes/class-minn-admin-rest.php:15383
msgid "wp-config.php did not save completely and could not be put back. A copy of the original is kept as %s."
msgstr "wp-config.php nie został w pełni zapisany i nie udało się go przywrócić. Kopia oryginału została zachowana jako %s."

#: includes/class-minn-admin-rest.php:15436
