#: includes/class-minn-admin-rest.php:8149
msgid "WordPress only stores layout width changes for someone who can post unfiltered HTML, which this account cannot on this site."
msgstr "WordPress zapisuje zmiany szerokości układu tylko dla kogoś, kto może publikować niefiltrowany HTML, czego to konto nie może robić na tej witrynie."

#: includes/class-minn-admin-rest.php:8400
msgid "That palette or typeset is not part of the active theme."
msgstr "Ta paleta lub zestaw typograficzny nie należy do aktywnego motywu."

