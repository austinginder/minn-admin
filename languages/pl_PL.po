#. translators: %s: the site's address.
#: includes/class-minn-admin-switch.php:772
msgid "Waiting for %s to answer as Minn…"
msgstr "Oczekiwanie, aż %s odpowie jako Minn…"

#: includes/class-minn-admin-switch.php:787
msgid "The site did not answer as Minn yet; flushing anyway. If it still shows WordPress in a minute, run: wp cache flush"
msgstr "Witryna nie odpowiedziała jeszcze jako Minn; pamięć podręczna jest czyszczona mimo to. Jeśli za minutę nadal widać WordPress, uruchom: wp cache flush"

#: includes/class-minn-admin-switch.php:798
msgid "Caches flushed (wp cache flush)."
msgstr "Pamięć podręczna wyczyszczona (wp cache flush)."

#: includes/class-minn-admin-switch.php:800
msgid "wp cache flush failed. If the host caches pages, purge its cache now."
msgstr "wp cache flush nie powiodło się. Jeśli hosting buforuje strony, wyczyść jego pamięć podręczną teraz."

#. translators: %s: Minn's version.
#: includes/class-minn-admin-switch.php:838
