msgid "Add the index"
msgstr "Foegje de yndeks ta"

#: includes/class-minn-admin-db.php:856
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Earst ophelje. It tafoegjen fan in yndeks slút de tabel koart."

#: includes/class-minn-admin-db.php:900
msgid "Auto-increment headroom"
msgstr "Auto-tanimme headroom"

#: includes/class-minn-admin-db.php:902
msgid "Healthy"
msgstr "Sûn"

