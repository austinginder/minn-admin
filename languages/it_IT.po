#: includes/class-minn-admin-rest.php:3722
msgid "The custom CSS was changed somewhere else after you opened it. Copy your edit, reload, and apply it again."
msgstr "Il CSS personalizzato è stato modificato altrove dopo che lo hai aperto. Copia la tua modifica, ricarica e applicala di nuovo."

#: includes/class-minn-admin-rest.php:3739
msgid "curly brackets"
msgstr "parentesi graffe"

