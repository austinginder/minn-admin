msgstr[1] "%s Speicherprüfungen erfordern Aufmerksamkeit"

#: includes/class-minn-admin-db.php:660
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Verwaiste Zeilen, Indizes und Engines sehen alle gesund aus"

#: includes/class-minn-admin-db.php:727
msgid "Tables without a primary key"
msgstr "Tabellen ohne Primärschlüssel"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:733
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Diese Tabellen haben keinen Primärschlüssel; das bricht die zeilenbasierte Replikation und verwirrt Backup- und Migrationswerkzeuge: %s"

#: includes/class-minn-admin-db.php:736
msgid "Every table has a primary key."
msgstr "Jede Tabelle hat einen Primärschlüssel."

#: includes/class-minn-admin-db.php:748
msgid "Storage engine"
msgstr "Storage-Engine"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:754
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Diese Tabellen nutzen kein InnoDB und haben daher kein zeilenbasiertes Locking und keine Crash-Recovery: %s"

#: includes/class-minn-admin-db.php:757
msgid "Every table uses InnoDB."
msgstr "Jede Tabelle nutzt InnoDB."

#: includes/class-minn-admin-db.php:759
msgid "Convert a table"
msgstr "Tabelle konvertieren"

#: includes/class-minn-admin-db.php:761
msgid "Back up first. Converting locks the table while it runs."
msgstr "Vorher ein Backup anlegen. Die Konvertierung sperrt die Tabelle, solange sie läuft."

#: includes/class-minn-admin-db.php:780
msgid "Reclaimable space"
msgstr "Rückgewinnbarer Speicher"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:787
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "Allein %1$s hält %2$s freien Speicher in der eigenen Datei. Das Optimieren schreibt die Tabelle neu und gibt ihn an die Festplatte zurück."

#: includes/class-minn-admin-db.php:791
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Keine Tabelle hält nennenswert rückgewinnbaren Speicher."

#: includes/class-minn-admin-db.php:793
msgid "Optimise tables"
msgstr "Tabellen optimieren"

#: includes/class-minn-admin-db.php:795
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Vorher ein Backup anlegen. Das Optimieren sperrt jede Tabelle, solange es läuft."

#: includes/class-minn-admin-db.php:813
msgid "Post meta lookup index"
msgstr "Index für Post-Meta-Abfragen"

#: includes/class-minn-admin-db.php:816
msgid "Present"
msgstr "Vorhanden"

#: includes/class-minn-admin-db.php:818
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Ein kombinierter Index aus post_id und meta_key ist vorhanden, sodass Meta-Abfragen schnell bleiben."

#: includes/class-minn-admin-db.php:819
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Abfragen nach Beitrag und Meta-Schlüssel greifen auf zwei getrennte Indizes zurück. Auf Websites mit starker Meta-Nutzung (WooCommerce, Event- und Buchungs-Plugins) ist ein kombinierter Index ein großer Geschwindigkeitsgewinn mit geringem Risiko."

#: includes/class-minn-admin-db.php:821
msgid "Add the index"
msgstr "Index hinzufügen"

#: includes/class-minn-admin-db.php:823
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Vorher ein Backup anlegen. Das Hinzufügen eines Index sperrt die Tabelle kurz."

#: includes/class-minn-admin-db.php:867
msgid "Auto-increment headroom"
msgstr "Auto-Increment-Spielraum"

#: includes/class-minn-admin-db.php:869
msgid "Healthy"
msgstr "Gesund"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:874
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Diese Tabellen liegen innerhalb von 20 Prozent der größten ID, die ihr Spaltentyp speichern kann. Ist die Grenze erreicht, werden keine neuen Zeilen mehr geschrieben: %s"

#: includes/class-minn-admin-db.php:877
msgid "No table is close to exhausting its id column."
msgstr "Keine Tabelle ist nahe daran, ihre ID-Spalte auszuschöpfen."

#: includes/class-minn-admin-db.php:885
msgid "Orphaned post meta"
msgstr "Verwaiste Beitrags-Metadaten"

#: includes/class-minn-admin-db.php:888
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Diese Meta-Zeilen gehören zu Beiträgen, die nicht mehr existieren. Sie sind totes Gewicht in jeder Abfrage, die Beitrags-Metadaten berührt."

#: includes/class-minn-admin-db.php:889
msgid "Every meta row belongs to a post that still exists."
msgstr "Jede Meta-Zeile gehört zu einem Beitrag, der noch existiert."

#: includes/class-minn-admin-db.php:891
#: includes/class-minn-admin-db.php:909
#: includes/class-minn-admin-db.php:927
msgid "Delete them"
msgstr "Sie löschen"

#: includes/class-minn-admin-db.php:893
#: includes/class-minn-admin-db.php:911
#: includes/class-minn-admin-db.php:929
msgid "Back up first. This permanently deletes rows."
msgstr "Vorher ein Backup anlegen. Dies löscht Zeilen endgültig."

#: includes/class-minn-admin-db.php:903
msgid "Orphaned user meta"
msgstr "Verwaiste Benutzer-Metadaten"

#: includes/class-minn-admin-db.php:906
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Diese Meta-Zeilen gehören zu Benutzern, die nicht mehr existieren — meist von einem Plugin zurückgelassen, das Konten direkt entfernt hat."

#: includes/class-minn-admin-db.php:907
msgid "Every meta row belongs to a user who still exists."
msgstr "Jede Meta-Zeile gehört zu einem Benutzer, der noch existiert."

#: includes/class-minn-admin-db.php:921
msgid "Orphaned term relationships"
msgstr "Verwaiste Begriffs-Beziehungen"

#: includes/class-minn-admin-db.php:924
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Diese Zeilen verknüpfen Inhalte mit Kategorien oder Schlagwörtern, die nicht mehr existieren."

#: includes/class-minn-admin-db.php:925
msgid "Every relationship points at a term that still exists."
msgstr "Jede Beziehung verweist auf einen Begriff, der noch existiert."

#: includes/class-minn-admin-db.php:939
msgid "Stored revisions"
msgstr "Gespeicherte Revisionen"

#: includes/class-minn-admin-db.php:942
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Revisionen sind das Sicherheitsnetz des Editors; eine große Zahl ist normal und kein Fehler. Sie zu kürzen lohnt sich nur, wenn die Beitragstabelle unhandlich geworden ist."

#: includes/class-minn-admin-db.php:943
msgid "No revisions are stored."
msgstr "Es sind keine Revisionen gespeichert."

#: includes/class-minn-admin-db.php:945
msgid "Delete all revisions"
msgstr "Alle Revisionen löschen"

#: includes/class-minn-admin-db.php:947
msgid "Back up first. This removes every saved revision permanently."
msgstr "Vorher ein Backup anlegen. Dies entfernt jede gespeicherte Revision endgültig."

#: includes/class-minn-admin-db.php:957
msgid "Spam and trashed comments"
msgstr "Spam- und Papierkorb-Kommentare"

#: includes/class-minn-admin-db.php:960
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Spam- und Papierkorb-Kommentare bleiben in der Datenbank, bis sie geleert werden. WordPress räumt sie nach einer Weile von selbst auf."

#: includes/class-minn-admin-db.php:961
msgid "No spam or trashed comments are waiting."
msgstr "Es warten keine Spam- oder Papierkorb-Kommentare."

#: includes/class-minn-admin-db.php:963
msgid "Delete spam"
msgstr "Spam löschen"

#: includes/class-minn-admin-db.php:965
msgid "Back up first. This permanently deletes the comments."
msgstr "Vorher ein Backup anlegen. Dies löscht die Kommentare endgültig."

#: includes/class-minn-admin-db.php:976
msgid "Expired WooCommerce sessions"
msgstr "Abgelaufene WooCommerce-Sitzungen"

#: includes/class-minn-admin-db.php:979
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Abgelaufene Warenkorb-Sitzungen sollten von einem geplanten WooCommerce-Job gelöscht werden. Ein großer Rückstand bedeutet meist, dass dieser Job nicht mehr läuft."

#: includes/class-minn-admin-db.php:980
msgid "No expired sessions are left behind."
msgstr "Es bleiben keine abgelaufenen Sitzungen zurück."

#: includes/class-minn-admin-db.php:982
msgid "Delete expired sessions"
msgstr "Abgelaufene Sitzungen löschen"

#: includes/class-minn-admin-db.php:984
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Vorher ein Backup anlegen. Käufer mit abgelaufenem Warenkorb verlieren ihn — was per Definition ohnehin schon passiert ist."

#: includes/class-minn-admin-db.php:995
msgid "Action Scheduler backlog"
msgstr "Action-Scheduler-Rückstand"

#: includes/class-minn-admin-db.php:998
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Ausstehende und fehlgeschlagene Hintergrund-Jobs. Ein gleichbleibender Rückstand ist in einem viel besuchten Shop normal; ein sehr großer deutet darauf hin, dass die Warteschlange nicht abgearbeitet wird."

#: includes/class-minn-admin-db.php:999
msgid "No pending or failed background jobs."
msgstr "Keine ausstehenden oder fehlgeschlagenen Hintergrund-Jobs."

#: includes/class-minn-admin-db.php:1001
msgid "Clean the queue"
msgstr "Warteschlange bereinigen"

#: includes/class-minn-admin-db.php:1003
msgid "Removes finished actions. Pending work is left alone."
msgstr "Entfernt abgeschlossene Aktionen. Ausstehende Arbeit bleibt unangetastet."

