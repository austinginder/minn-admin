#: includes/class-minn-admin-db.php:1399
#: includes/class-minn-admin-db.php:1428
#: includes/class-minn-admin-db.php:1590
msgid "Unknown table."
msgstr "Table inconnue."

#: includes/class-minn-admin-db.php:1403
#: includes/class-minn-admin-db.php:1432
msgid "Could not read the table structure."
msgstr "Impossible de lire la structure de la table."

#: includes/class-minn-admin-db.php:1471
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Cette colonne contient des mots de passe ou des jetons, elle ne peut donc pas être recherchée."

#: includes/class-minn-admin-db.php:1494
msgid "This site holds too many credentials for Minn to check a value search against, so values cannot be searched here."
msgstr "Ce site contient trop d’identifiants pour que Minn puisse y vérifier une recherche de valeur, les valeurs ne peuvent donc pas être recherchées ici."

#: includes/class-minn-admin-db.php:1596
msgid "This table has no usable primary key."
msgstr "Cette table n’a pas de clé primaire utilisable."

#: includes/class-minn-admin-db.php:1606
msgid "Row not found."
msgstr "Ligne introuvable."

#: includes/class-minn-admin-db.php:1673
msgid "Not checked"
msgstr "Non vérifiée"

#: includes/class-minn-admin-db.php:1674
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Cette table est trop grande pour être comptée à moindre coût ; Minn ne l’analyse pas. Exécuter la commande ci-dessous pour la vérifier."

#: includes/class-minn-admin-db.php:1724
msgid "Database hygiene"
msgstr "Hygiène de la base de données"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:1730
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s vérification de stockage à examiner"
msgstr[1] "%s vérifications de stockage à examiner"

#: includes/class-minn-admin-db.php:1738
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Lignes orphelines, index et moteurs semblent tous sains"

#: includes/class-minn-admin-db.php:1805
msgid "Tables without a primary key"
msgstr "Tables sans clé primaire"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1811
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Ces tables n’ont pas de clé primaire, ce qui casse la réplication par ligne et perturbe les outils de sauvegarde et de migration : %s"

#: includes/class-minn-admin-db.php:1814
msgid "Every table has a primary key."
msgstr "Toutes les tables ont une clé primaire."

#: includes/class-minn-admin-db.php:1826
msgid "Storage engine"
msgstr "Moteur de stockage"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:1832
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Ces tables n’utilisent pas InnoDB : elles n’ont ni verrouillage par ligne ni récupération après incident : %s"

#: includes/class-minn-admin-db.php:1835
msgid "Every table uses InnoDB."
msgstr "Toutes les tables utilisent InnoDB."

#: includes/class-minn-admin-db.php:1837
msgid "Convert a table"
msgstr "Convertir une table"

#: includes/class-minn-admin-db.php:1839
msgid "Back up first. Converting locks the table while it runs."
msgstr "Sauvegarder d’abord. La conversion verrouille la table pendant son exécution."

#: includes/class-minn-admin-db.php:1858
msgid "Reclaimable space"
msgstr "Espace récupérable"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:1865
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "%1$s retient à elle seule %2$s d’espace libre dans son propre fichier. L’optimisation réécrit la table et rend cet espace au disque."

#: includes/class-minn-admin-db.php:1869
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Aucune table ne retient une quantité notable d’espace récupérable."

#: includes/class-minn-admin-db.php:1871
msgid "Optimise tables"
msgstr "Optimiser les tables"

#: includes/class-minn-admin-db.php:1873
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Sauvegarder d’abord. L’optimisation verrouille chaque table pendant son exécution."

#: includes/class-minn-admin-db.php:1891
msgid "Post meta lookup index"
msgstr "Index de recherche des métadonnées d’article"

#: includes/class-minn-admin-db.php:1894
msgid "Present"
msgstr "Présent"

#: includes/class-minn-admin-db.php:1896
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Un index combiné post_id et meta_key est présent : les recherches de métadonnées restent rapides."

#: includes/class-minn-admin-db.php:1897
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Les recherches par article et clé méta reposent sur deux index distincts. Sur les sites qui utilisent beaucoup les métadonnées (WooCommerce, extensions d’évènements et de réservation), un index combiné apporte un gain de vitesse important et sans risque."

#: includes/class-minn-admin-db.php:1899
msgid "Add the index"
msgstr "Ajouter l’index"

#: includes/class-minn-admin-db.php:1901
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Sauvegarder d’abord. L’ajout d’un index verrouille brièvement la table."

#: includes/class-minn-admin-db.php:1945
msgid "Auto-increment headroom"
msgstr "Marge d’auto-incrémentation"

#: includes/class-minn-admin-db.php:1947
msgid "Healthy"
msgstr "Sain"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1952
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Ces tables sont à moins de 20 pour cent du plus grand identifiant que leur type de colonne peut stocker. Une fois le plafond atteint, plus aucune ligne n’est écrite : %s"

#: includes/class-minn-admin-db.php:1955
msgid "No table is close to exhausting its id column."
msgstr "Aucune table n’approche la limite de sa colonne d’identifiants."

#: includes/class-minn-admin-db.php:1963
msgid "Orphaned post meta"
msgstr "Métadonnées d’articles orphelines"

#: includes/class-minn-admin-db.php:1966
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Ces lignes de métadonnées appartiennent à des articles qui n’existent plus. Elles alourdissent chaque requête sur les métadonnées d’articles."

#: includes/class-minn-admin-db.php:1967
msgid "Every meta row belongs to a post that still exists."
msgstr "Chaque ligne de métadonnées appartient à un article existant."

#: includes/class-minn-admin-db.php:1969
#: includes/class-minn-admin-db.php:1987
#: includes/class-minn-admin-db.php:2005
msgid "Delete them"
msgstr "Les supprimer"

#: includes/class-minn-admin-db.php:1971
#: includes/class-minn-admin-db.php:1989
#: includes/class-minn-admin-db.php:2007
msgid "Back up first. This permanently deletes rows."
msgstr "Sauvegarder d’abord. Cette action supprime définitivement des lignes."

#: includes/class-minn-admin-db.php:1981
msgid "Orphaned user meta"
msgstr "Métadonnées de comptes orphelines"

#: includes/class-minn-admin-db.php:1984
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Ces lignes de métadonnées appartiennent à des comptes qui n’existent plus, souvent laissées par une extension ayant supprimé des comptes directement."

#: includes/class-minn-admin-db.php:1985
msgid "Every meta row belongs to a user who still exists."
msgstr "Chaque ligne de métadonnées appartient à un compte existant."

#: includes/class-minn-admin-db.php:1999
msgid "Orphaned term relationships"
msgstr "Relations de termes orphelines"

#: includes/class-minn-admin-db.php:2002
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Ces lignes relient du contenu à des catégories ou étiquettes qui n’existent plus."

#: includes/class-minn-admin-db.php:2003
msgid "Every relationship points at a term that still exists."
msgstr "Chaque relation pointe vers un terme existant."

#: includes/class-minn-admin-db.php:2017
msgid "Stored revisions"
msgstr "Révisions enregistrées"

#: includes/class-minn-admin-db.php:2020
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Les révisions sont le filet de sécurité de l’éditeur : un grand nombre est normal et non problématique. Les élaguer n’a d’intérêt que si la table des articles est devenue trop lourde."

#: includes/class-minn-admin-db.php:2021
msgid "No revisions are stored."
msgstr "Aucune révision enregistrée."

#: includes/class-minn-admin-db.php:2023
msgid "Delete all revisions"
msgstr "Supprimer toutes les révisions"

#: includes/class-minn-admin-db.php:2025
msgid "Back up first. This removes every saved revision permanently."
msgstr "Sauvegarder d’abord. Cette action supprime définitivement toutes les révisions."

#: includes/class-minn-admin-db.php:2035
msgid "Spam and trashed comments"
msgstr "Commentaires indésirables et à la corbeille"

#: includes/class-minn-admin-db.php:2038
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Les commentaires indésirables et ceux à la corbeille restent en base jusqu’à leur vidage. WordPress les efface de lui-même au bout d’un certain temps."

#: includes/class-minn-admin-db.php:2039
msgid "No spam or trashed comments are waiting."
msgstr "Aucun commentaire indésirable ni à la corbeille en attente."

#: includes/class-minn-admin-db.php:2041
msgid "Delete spam"
msgstr "Supprimer les indésirables"

#: includes/class-minn-admin-db.php:2043
msgid "Back up first. This permanently deletes the comments."
msgstr "Sauvegarder d’abord. Cette action supprime définitivement les commentaires."

#: includes/class-minn-admin-db.php:2054
msgid "Expired WooCommerce sessions"
msgstr "Sessions WooCommerce expirées"

#: includes/class-minn-admin-db.php:2057
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Les sessions de panier expirées devraient être effacées par une tâche planifiée de WooCommerce. Un gros arriéré signifie souvent que cette tâche ne s’exécute plus."

#: includes/class-minn-admin-db.php:2058
msgid "No expired sessions are left behind."
msgstr "Aucune session expirée ne subsiste."

#: includes/class-minn-admin-db.php:2060
msgid "Delete expired sessions"
msgstr "Supprimer les sessions expirées"

#: includes/class-minn-admin-db.php:2062
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Sauvegarder d’abord. Les acheteurs dont le panier a expiré le perdent, ce qui est déjà le cas par définition."

#: includes/class-minn-admin-db.php:2073
msgid "Action Scheduler backlog"
msgstr "Arriéré d’Action Scheduler"

#: includes/class-minn-admin-db.php:2076
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Tâches en arrière-plan en attente ou en échec. Un arriéré régulier est normal sur une boutique active ; un arriéré très important indique que la file ne se vide pas."

#: includes/class-minn-admin-db.php:2077
msgid "No pending or failed background jobs."
msgstr "Aucune tâche en arrière-plan en attente ou en échec."

#: includes/class-minn-admin-db.php:2079
msgid "Clean the queue"
msgstr "Nettoyer la file"

#: includes/class-minn-admin-db.php:2081
msgid "Removes finished actions. Pending work is left alone."
msgstr "Retire les actions terminées. Les tâches en attente ne sont pas touchées."

#: includes/class-minn-admin-fences.php:202
msgid "Part of this change was not saved: it would have changed who can run this site, which your account can’t do."
msgstr "Une partie de cette modification n’a pas été enregistrée : elle aurait changé qui peut administrer ce site, ce que votre compte ne peut pas faire."

#: includes/class-minn-admin-logs.php:93
msgid "PHP error log"
msgstr "Journal d’erreurs PHP"

#: includes/class-minn-admin-logs.php:93
#: includes/class-minn-admin-rest.php:12579
msgid "Server"
msgstr "Serveur"

#: includes/class-minn-admin-logs.php:175
#: includes/class-minn-admin-logs.php:200
msgid "Unknown log source."
msgstr "Source de journal inconnue."

