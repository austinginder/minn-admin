#: includes/class-minn-admin-db.php:766
#: includes/class-minn-admin-db.php:794
#: includes/class-minn-admin-db.php:920
msgid "Unknown table."
msgstr "Onbekende tabel."

#: includes/class-minn-admin-db.php:770
#: includes/class-minn-admin-db.php:798
msgid "Could not read the table structure."
msgstr "Kon de tabelstructuur niet lezen."

#: includes/class-minn-admin-db.php:829
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Die kolom bevat wachtwoorden of tokens, dus er kan niet in gezocht worden."

#: includes/class-minn-admin-db.php:926
msgid "This table has no usable primary key."
msgstr "Deze tabel heeft geen bruikbare primaire sleutel."

#: includes/class-minn-admin-db.php:936
msgid "Row not found."
msgstr "Rij niet gevonden."

#: includes/class-minn-admin-db.php:996
msgid "Not checked"
msgstr "Niet gecontroleerd"

#: includes/class-minn-admin-db.php:997
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Deze tabel is te groot om snel te tellen, dus Minn scant hem niet. Voer de opdracht hieronder uit om hem zelf te controleren."

#: includes/class-minn-admin-db.php:1047
msgid "Database hygiene"
msgstr "Databasehygiëne"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:1053
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s opslagcontrole vereist aandacht"
msgstr[1] "%s opslagcontroles vereisen aandacht"

#: includes/class-minn-admin-db.php:1061
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Verweesde rijen, indexen en engines zien er gezond uit"

#: includes/class-minn-admin-db.php:1128
msgid "Tables without a primary key"
msgstr "Tabellen zonder primaire sleutel"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1134
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "Deze tabellen hebben geen primaire sleutel, wat replicatie op rijniveau breekt en back-up- en migratietools in de war brengt: %s"

#: includes/class-minn-admin-db.php:1137
msgid "Every table has a primary key."
msgstr "Elke tabel heeft een primaire sleutel."

#: includes/class-minn-admin-db.php:1149
msgid "Storage engine"
msgstr "Opslag-engine"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:1155
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "Deze tabellen gebruiken geen InnoDB, dus missen ze vergrendeling op rijniveau en crashherstel: %s"

#: includes/class-minn-admin-db.php:1158
msgid "Every table uses InnoDB."
msgstr "Elke tabel gebruikt InnoDB."

#: includes/class-minn-admin-db.php:1160
msgid "Convert a table"
msgstr "Een tabel converteren"

#: includes/class-minn-admin-db.php:1162
msgid "Back up first. Converting locks the table while it runs."
msgstr "Maak eerst een back-up. Converteren vergrendelt de tabel tijdens het uitvoeren."

#: includes/class-minn-admin-db.php:1181
msgid "Reclaimable space"
msgstr "Terugwinbare ruimte"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:1188
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "%1$s houdt alleen al %2$s vrije ruimte vast in het eigen bestand. Optimaliseren herschrijft de tabel en geeft die ruimte terug aan de schijf."

#: includes/class-minn-admin-db.php:1192
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Geen enkele tabel houdt een noemenswaardige hoeveelheid terugwinbare ruimte vast."

#: includes/class-minn-admin-db.php:1194
msgid "Optimise tables"
msgstr "Tabellen optimaliseren"

#: includes/class-minn-admin-db.php:1196
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Maak eerst een back-up. Optimaliseren vergrendelt elke tabel tijdens het uitvoeren."

#: includes/class-minn-admin-db.php:1214
msgid "Post meta lookup index"
msgstr "Opzoekindex voor bericht-meta"

#: includes/class-minn-admin-db.php:1217
msgid "Present"
msgstr "Aanwezig"

#: includes/class-minn-admin-db.php:1219
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Een gecombineerde index op post_id en meta_key is aanwezig, dus meta-lookups blijven snel."

#: includes/class-minn-admin-db.php:1220
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Opzoeken op bericht en meta-sleutel valt terug op twee losse indexen. Op sites met veel meta-gebruik (WooCommerce, evenementen- en boekingsplugins) is een gecombineerde index een grote, risicoarme snelheidswinst."

#: includes/class-minn-admin-db.php:1222
msgid "Add the index"
msgstr "De index toevoegen"

#: includes/class-minn-admin-db.php:1224
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Maak eerst een back-up. Een index toevoegen vergrendelt de tabel kort."

#: includes/class-minn-admin-db.php:1268
msgid "Auto-increment headroom"
msgstr "Auto-increment ruimte"

#: includes/class-minn-admin-db.php:1270
msgid "Healthy"
msgstr "Gezond"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1275
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "Deze tabellen zitten binnen 20 procent van de grootste id die hun kolomtype kan opslaan. Zodra het plafond bereikt is, worden er geen nieuwe rijen meer geschreven: %s"

#: includes/class-minn-admin-db.php:1278
msgid "No table is close to exhausting its id column."
msgstr "Geen enkele tabel zit dicht bij de limiet van zijn id-kolom."

#: includes/class-minn-admin-db.php:1286
msgid "Orphaned post meta"
msgstr "Verweesde bericht-meta"

#: includes/class-minn-admin-db.php:1289
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "Deze meta-rijen horen bij berichten die niet meer bestaan. Ze zijn dode ballast in elke query die bericht-meta raakt."

#: includes/class-minn-admin-db.php:1290
msgid "Every meta row belongs to a post that still exists."
msgstr "Elke meta-rij hoort bij een bericht dat nog bestaat."

#: includes/class-minn-admin-db.php:1292
#: includes/class-minn-admin-db.php:1310
#: includes/class-minn-admin-db.php:1328
msgid "Delete them"
msgstr "Verwijderen"

#: includes/class-minn-admin-db.php:1294
#: includes/class-minn-admin-db.php:1312
#: includes/class-minn-admin-db.php:1330
msgid "Back up first. This permanently deletes rows."
msgstr "Maak eerst een back-up. Dit verwijdert rijen permanent."

#: includes/class-minn-admin-db.php:1304
msgid "Orphaned user meta"
msgstr "Verweesde gebruiker-meta"

#: includes/class-minn-admin-db.php:1307
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "Deze meta-rijen horen bij gebruikers die niet meer bestaan, meestal achtergelaten door een plugin die accounts direct verwijderde."

#: includes/class-minn-admin-db.php:1308
msgid "Every meta row belongs to a user who still exists."
msgstr "Elke meta-rij hoort bij een gebruiker die nog bestaat."

#: includes/class-minn-admin-db.php:1322
msgid "Orphaned term relationships"
msgstr "Verweesde termrelaties"

#: includes/class-minn-admin-db.php:1325
msgid "These rows link content to categories or tags that no longer exist."
msgstr "Deze rijen koppelen content aan categorieën of tags die niet meer bestaan."

#: includes/class-minn-admin-db.php:1326
msgid "Every relationship points at a term that still exists."
msgstr "Elke relatie wijst naar een term die nog bestaat."

#: includes/class-minn-admin-db.php:1340
msgid "Stored revisions"
msgstr "Opgeslagen revisies"

#: includes/class-minn-admin-db.php:1343
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Revisies zijn het vangnet van de editor, dus een groot aantal is normaal en geen fout. Opschonen loont alleen als de berichtentabel onhandelbaar groot is geworden."

#: includes/class-minn-admin-db.php:1344
msgid "No revisions are stored."
msgstr "Er zijn geen revisies opgeslagen."

#: includes/class-minn-admin-db.php:1346
msgid "Delete all revisions"
msgstr "Alle revisies verwijderen"

#: includes/class-minn-admin-db.php:1348
msgid "Back up first. This removes every saved revision permanently."
msgstr "Maak eerst een back-up. Dit verwijdert elke opgeslagen revisie permanent."

#: includes/class-minn-admin-db.php:1358
msgid "Spam and trashed comments"
msgstr "Spam en reacties in de prullenbak"

#: includes/class-minn-admin-db.php:1361
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Spam en reacties in de prullenbak blijven in de database tot ze geleegd worden. WordPress ruimt ze na een tijdje zelf op."

#: includes/class-minn-admin-db.php:1362
msgid "No spam or trashed comments are waiting."
msgstr "Er staan geen spam- of prullenbakreacties klaar."

#: includes/class-minn-admin-db.php:1364
msgid "Delete spam"
msgstr "Spam verwijderen"

#: includes/class-minn-admin-db.php:1366
msgid "Back up first. This permanently deletes the comments."
msgstr "Maak eerst een back-up. Dit verwijdert de reacties permanent."

#: includes/class-minn-admin-db.php:1377
msgid "Expired WooCommerce sessions"
msgstr "Verlopen WooCommerce-sessies"

#: includes/class-minn-admin-db.php:1380
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Verlopen winkelwagensessies horen door een geplande WooCommerce-taak opgeruimd te worden. Een grote achterstand betekent meestal dat die taak niet meer draait."

#: includes/class-minn-admin-db.php:1381
msgid "No expired sessions are left behind."
msgstr "Er zijn geen verlopen sessies achtergebleven."

#: includes/class-minn-admin-db.php:1383
msgid "Delete expired sessions"
msgstr "Verlopen sessies verwijderen"

#: includes/class-minn-admin-db.php:1385
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Maak eerst een back-up. Klanten met een verlopen winkelwagen raken die kwijt, wat per definitie al gebeurd is."

#: includes/class-minn-admin-db.php:1396
msgid "Action Scheduler backlog"
msgstr "Action Scheduler-achterstand"

#: includes/class-minn-admin-db.php:1399
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Wachtende en mislukte achtergrondtaken. Een constante achterstand is normaal in een drukke winkel; een zeer grote wijst erop dat de wachtrij niet leegloopt."

#: includes/class-minn-admin-db.php:1400
msgid "No pending or failed background jobs."
msgstr "Geen wachtende of mislukte achtergrondtaken."

#: includes/class-minn-admin-db.php:1402
msgid "Clean the queue"
msgstr "Wachtrij opschonen"

#: includes/class-minn-admin-db.php:1404
msgid "Removes finished actions. Pending work is left alone."
msgstr "Verwijdert afgeronde acties. Wachtend werk blijft staan."

