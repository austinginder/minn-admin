#: includes/class-minn-admin-rest.php:1419
msgid "Link to the payment in the payment provider's dashboard, as the order screen shows it."
msgstr "קישור לתשלום בלוח הבקרה של ספק התשלום, כפי שמסך ההזמנה מציג אותו."

#: includes/class-minn-admin-rest.php:2221
msgid "Whether an autosave newer than the saved post exists (live post carrying unsaved edits)."
msgstr "האם קיימת שמירה אוטומטית חדשה יותר מהפוסט השמור (פוסט חי עם עריכות שלא נשמרו)."

#: includes/class-minn-admin-rest.php:2269
