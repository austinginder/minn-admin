#: includes/class-minn-admin-db.php:519
#: includes/class-minn-admin-db.php:547
#: includes/class-minn-admin-db.php:658
msgid "Unknown table."
msgstr "טבלה לא ידועה."

#: includes/class-minn-admin-db.php:523
#: includes/class-minn-admin-db.php:551
msgid "Could not read the table structure."
msgstr "לא ניתן לקרוא את מבנה הטבלה."

#: includes/class-minn-admin-db.php:664
msgid "This table has no usable primary key."
msgstr "לטבלה הזו אין מפתח ראשי שמיש."

#: includes/class-minn-admin-db.php:674
msgid "Row not found."
msgstr "השורה לא נמצאה."

#: includes/class-minn-admin-db.php:734
msgid "Not checked"
msgstr "לא נבדק"

#: includes/class-minn-admin-db.php:735
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "הטבלה הזו גדולה מדי לספירה זולה, ולכן Minn לא סורק אותה. הרץ את הפקודה למטה כדי לבדוק בעצמך."

#: includes/class-minn-admin-db.php:785
msgid "Database hygiene"
msgstr "היגיינת מסד נתונים"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:791
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s בדיקת אחסון דורשת התייחסות"
msgstr[1] "%s בדיקות אחסון דורשות התייחסות"

#: includes/class-minn-admin-db.php:799
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "שורות יתומות, אינדקסים ומנועים נראים תקינים"

#: includes/class-minn-admin-db.php:866
msgid "Tables without a primary key"
msgstr "טבלאות בלי מפתח ראשי"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:872
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "לטבלאות האלה אין מפתח ראשי, מה ששובר שכפול ברמת שורה ומבלבל כלי גיבוי והעברה: %s"

#: includes/class-minn-admin-db.php:875
msgid "Every table has a primary key."
msgstr "לכל טבלה יש מפתח ראשי."

#: includes/class-minn-admin-db.php:887
msgid "Storage engine"
msgstr "מנוע אחסון"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:893
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "הטבלאות האלה לא משתמשות ב-InnoDB, ולכן הן מפספסות נעילה ברמת שורה ושחזור מקריסה: %s"

#: includes/class-minn-admin-db.php:896
msgid "Every table uses InnoDB."
msgstr "כל טבלה משתמשת ב-InnoDB."

#: includes/class-minn-admin-db.php:898
msgid "Convert a table"
msgstr "המר טבלה"

#: includes/class-minn-admin-db.php:900
msgid "Back up first. Converting locks the table while it runs."
msgstr "גבה קודם. ההמרה נועלת את הטבלה בזמן שהיא רצה."

#: includes/class-minn-admin-db.php:919
msgid "Reclaimable space"
msgstr "שטח ניתן לשחרור"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:926
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "%1$s לבדה מחזיקה %2$s של שטח פנוי בתוך הקובץ שלה. ייעול כותב מחדש את הטבלה ומחזיר אותו לדיסק."

#: includes/class-minn-admin-db.php:930
msgid "No table is holding a significant amount of reclaimable space."
msgstr "אף טבלה לא מחזיקה כמות משמעותית של שטח שניתן לשחרור."

#: includes/class-minn-admin-db.php:932
msgid "Optimise tables"
msgstr "ייעול טבלאות"

#: includes/class-minn-admin-db.php:934
msgid "Back up first. Optimising locks each table while it runs."
msgstr "גבה קודם. הייעול נועל כל טבלה בזמן שהוא רץ."

#: includes/class-minn-admin-db.php:952
msgid "Post meta lookup index"
msgstr "אינדקס חיפוש מטא של פוסטים"

#: includes/class-minn-admin-db.php:955
msgid "Present"
msgstr "קיים"

#: includes/class-minn-admin-db.php:957
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "קיים אינדקס משולב של post_id ו-meta_key, כך שחיפושי מטא נשארים מהירים."

#: includes/class-minn-admin-db.php:958
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "חיפושים לפי פוסט ומפתח מטא נופלים לשני אינדקסים נפרדים. באתרים עם שימוש כבד במטא (WooCommerce, תוספי אירועים והזמנות) אינדקס משולב הוא רווח מהירות גדול ובעל סיכון נמוך."

#: includes/class-minn-admin-db.php:960
msgid "Add the index"
msgstr "הוסף את האינדקס"

#: includes/class-minn-admin-db.php:962
msgid "Back up first. Adding an index locks the table briefly."
msgstr "גבה קודם. הוספת אינדקס נועלת את הטבלה לזמן קצר."

#: includes/class-minn-admin-db.php:1006
msgid "Auto-increment headroom"
msgstr "מרווח auto-increment"

#: includes/class-minn-admin-db.php:1008
msgid "Healthy"
msgstr "תקין"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1013
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "הטבלאות האלה בטווח של 20 אחוז מהמזהה הגדול ביותר שסוג העמודה יכול לאחסן. כשמגיעים לתקרה, שורות חדשות מפסיקות להיכתב: %s"

#: includes/class-minn-admin-db.php:1016
msgid "No table is close to exhausting its id column."
msgstr "אף טבלה לא קרובה למיצוי עמודת המזהה שלה."

#: includes/class-minn-admin-db.php:1024
msgid "Orphaned post meta"
msgstr "מטא פוסטים יתומים"

#: includes/class-minn-admin-db.php:1027
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "שורות המטא האלה שייכות לפוסטים שכבר לא קיימים. הן משקל מת בכל שאילתה שנוגעת במטא של פוסטים."

#: includes/class-minn-admin-db.php:1028
msgid "Every meta row belongs to a post that still exists."
msgstr "כל שורת מטא שייכת לפוסט שעדיין קיים."

#: includes/class-minn-admin-db.php:1030
#: includes/class-minn-admin-db.php:1048
#: includes/class-minn-admin-db.php:1066
msgid "Delete them"
msgstr "מחק אותן"

#: includes/class-minn-admin-db.php:1032
#: includes/class-minn-admin-db.php:1050
#: includes/class-minn-admin-db.php:1068
msgid "Back up first. This permanently deletes rows."
msgstr "גבה קודם. זה מוחק שורות לצמיתות."

#: includes/class-minn-admin-db.php:1042
msgid "Orphaned user meta"
msgstr "מטא משתמשים יתומים"

#: includes/class-minn-admin-db.php:1045
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "שורות המטא האלה שייכות למשתמשים שכבר לא קיימים, בדרך כלל נשארו מתוסף שמחק חשבונות ישירות."

#: includes/class-minn-admin-db.php:1046
msgid "Every meta row belongs to a user who still exists."
msgstr "כל שורת מטא שייכת למשתמש שעדיין קיים."

#: includes/class-minn-admin-db.php:1060
msgid "Orphaned term relationships"
msgstr "קשרי מונחים יתומים"

#: includes/class-minn-admin-db.php:1063
msgid "These rows link content to categories or tags that no longer exist."
msgstr "השורות האלה מקשרות תוכן לקטגוריות או לתגיות שכבר לא קיימות."

#: includes/class-minn-admin-db.php:1064
msgid "Every relationship points at a term that still exists."
msgstr "כל קשר מצביע על מונח שעדיין קיים."

#: includes/class-minn-admin-db.php:1078
msgid "Stored revisions"
msgstr "גרסאות שמורות"

#: includes/class-minn-admin-db.php:1081
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "גרסאות הן רשת הביטחון של העורך, ולכן מספר גדול הוא נורמלי ולא תקלה. קיצוץ שלהן משתלם רק אם טבלת הפוסטים גדלה יותר מדי."

#: includes/class-minn-admin-db.php:1082
msgid "No revisions are stored."
msgstr "אין גרסאות שמורות."

#: includes/class-minn-admin-db.php:1084
msgid "Delete all revisions"
msgstr "מחק את כל הגרסאות"

#: includes/class-minn-admin-db.php:1086
msgid "Back up first. This removes every saved revision permanently."
msgstr "גבה קודם. זה מסיר כל גרסה שמורה לצמיתות."

#: includes/class-minn-admin-db.php:1096
msgid "Spam and trashed comments"
msgstr "תגובות ספאם ופח"

#: includes/class-minn-admin-db.php:1099
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "תגובות ספאם ותגובות בפח נשארות במסד הנתונים עד שמרוקנים אותן. וורדפרס מנקה אותן לבד אחרי זמן מה."

#: includes/class-minn-admin-db.php:1100
msgid "No spam or trashed comments are waiting."
msgstr "אין תגובות ספאם או בפח שממתינות."

#: includes/class-minn-admin-db.php:1102
msgid "Delete spam"
msgstr "מחק ספאם"

#: includes/class-minn-admin-db.php:1104
msgid "Back up first. This permanently deletes the comments."
msgstr "גבה קודם. זה מוחק את התגובות לצמיתות."

#: includes/class-minn-admin-db.php:1115
msgid "Expired WooCommerce sessions"
msgstr "סשני WooCommerce שפג תוקפם"

#: includes/class-minn-admin-db.php:1118
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "סשני עגלה שפג תוקפם אמורים להתנקות במשימת WooCommerce מתוזמנת. צבר גדול בדרך כלל אומר שהמשימה הפסיקה לרוץ."

#: includes/class-minn-admin-db.php:1119
msgid "No expired sessions are left behind."
msgstr "לא נשארו סשנים שפג תוקפם."

#: includes/class-minn-admin-db.php:1121
msgid "Delete expired sessions"
msgstr "מחק סשנים שפג תוקפם"

#: includes/class-minn-admin-db.php:1123
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "גבה קודם. קונים עם עגלה שפג תוקפה מאבדים אותה, וזה כבר קרה בהגדרה."

#: includes/class-minn-admin-db.php:1134
msgid "Action Scheduler backlog"
msgstr "צבר Action Scheduler"

