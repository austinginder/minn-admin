msgstr "JetEngine לא הצליח לשמור את סוג הפוסט."

#: includes/class-minn-admin-cpt.php:1837
#: includes/class-minn-admin-cpt.php:1840
msgid "JetEngine could not save the taxonomy."
msgstr "JetEngine לא הצליח לשמור את הטקסונומיה."

#: includes/class-minn-admin-cpt.php:1848
msgid "JetEngine definition not found."
msgstr "הגדרת JetEngine לא נמצאה."

#: includes/class-minn-admin-cpt.php:1855
#: includes/class-minn-admin-cpt.php:1857
