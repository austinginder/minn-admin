msgstr "ההגדרה הוסרה; התוכן הקיים נשאר במסד הנתונים."

#: includes/class-minn-admin-cpt.php:1340
msgid "Slug is required: lowercase letters, numbers, dashes or underscores, 32 characters max."
msgstr "נדרש מזהה כתובת: אותיות קטנות, מספרים, מקפים או קווים תחתונים, עד 32 תווים."

#: includes/class-minn-admin-cpt.php:1375
msgid "No such taxonomy."
msgstr "אין טקסונומיה כזו."

#: includes/class-minn-admin-cpt.php:1384
msgid "This taxonomy is registered in code and can only be changed there."
msgstr "הטקסונומיה הזו רשומה בקוד ואפשר לשנות אותה רק שם."

#: includes/class-minn-admin-cpt.php:1484
msgid "This taxonomy is registered in code and can only be removed there."
msgstr "הטקסונומיה הזו רשומה בקוד ואפשר להסיר אותה רק שם."

#: includes/class-minn-admin-cpt.php:1487
