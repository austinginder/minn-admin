msgstr "(לא ידוע)"

#: includes/class-minn-admin-rest.php:2584
msgid "That log lives outside this site, so Minn will not clear it."
msgstr "היומן נמצא מחוץ לאתר הזה, ולכן Minn לא ינקה אותו."

#: includes/class-minn-admin-rest.php:2592
msgid "The debug log is not writable."
msgstr "יומן הדיבאג אינו ניתן לכתיבה."

#: includes/class-minn-admin-rest.php:2596
msgid "Could not clear the debug log."
msgstr "לא ניתן לנקות את יומן הדיבאג."

#: includes/class-minn-admin-rest.php:2619
msgid "That block does not offer image editing here."
msgstr "הבלוק הזה לא מציע עריכת תמונות כאן."

#: includes/class-minn-admin-rest.php:2628
msgid "One of those images cannot be used here."
msgstr "לא ניתן להשתמש כאן באחת מהתמונות האלה."

#: includes/class-minn-admin-rest.php:2642
msgid "Pick at least one image."
msgstr "בחר לפחות תמונה אחת."

#: includes/class-minn-admin-rest.php:2651
msgid "That block could not be rebuilt for those images."
msgstr "לא ניתן היה לבנות מחדש את הבלוק עבור התמונות האלה."

#: includes/class-minn-admin-rest.php:2712
msgid "Expected an array of block markup strings."
msgstr "צפוי מערך של מחרוזות סימון בלוקים."

#: includes/class-minn-admin-rest.php:3061
#: includes/class-minn-admin-rest.php:3086
msgid "That surface has no setup to run."
msgstr "למסך הזה אין הגדרה להריץ."

#: includes/class-minn-admin-rest.php:3089
msgid "This setup runs on the plugin's own screen."
msgstr "ההגדרה הזו רצה במסך של התוסף עצמו."

#: includes/class-minn-admin-rest.php:3109
msgid "The plugin reported an error during setup."
msgstr "התוסף דיווח על שגיאה במהלך ההגדרה."

#: includes/class-minn-admin-rest.php:3164
msgid "Pattern not found."
msgstr "מקבץ הבלוקים לא נמצא."

#: includes/class-minn-admin-rest.php:3229
msgid "A custom structure needs at least one tag, e.g. %postname%."
msgstr "מבנה מותאם דורש לפחות תגית אחת, למשל %postname%."

#: includes/class-minn-admin-rest.php:3286
msgid "curly brackets"
msgstr "סוגריים מסולסלים"

#: includes/class-minn-admin-rest.php:3287
msgid "parentheses"
msgstr "סוגריים"

#: includes/class-minn-admin-rest.php:3288
msgid "square brackets"
msgstr "סוגריים מרובעים"

#. translators: %s: the bracket type that is unbalanced (e.g. "curly brackets").
#: includes/class-minn-admin-rest.php:3293
msgid "That CSS has unbalanced %s. Fix it and save again; nothing was changed."
msgstr "ב-CSS הזה יש %s לא מאוזנים. תקן ושמור שוב; דבר לא השתנה."

#: includes/class-minn-admin-rest.php:3297
msgid "That CSS has an unclosed comment. Fix it and save again; nothing was changed."
msgstr "ב-CSS הזה יש הערה שלא נסגרה. תקן ושמור שוב; דבר לא השתנה."

#. translators: 1: the window's first day (e.g. "Jun 3"). 2: its last day with the year (e.g. "Jul 2, 2026").
#: includes/class-minn-admin-rest.php:3363
msgid "%1$s – %2$s"
msgstr "%1$s – %2$s"

#. translators: %s: the date the week starts on (e.g. "Jun 3, 2026").
#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:3366
#: includes/class-minn-admin-rest.php:3762
msgid "Week of %s"
msgstr "השבוע של %s"

#: includes/class-minn-admin-rest.php:3401
#: includes/class-minn-admin-rest.php:3486
#: includes/class-minn-admin-rest.php:4534
msgid "from must be on or before to."
msgstr "תאריך ההתחלה חייב להיות לפני תאריך הסיום או באותו יום."

#: includes/class-minn-admin-rest.php:3413
msgid "Custom ranges reach back two years at most."
