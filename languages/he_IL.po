#. translators: %s: the date the week starts on (e.g. "Jun 3").
#: includes/class-minn-admin-rest.php:2757
#: includes/class-minn-admin-rest.php:3102
msgid "Week of %s"
msgstr "השבוע של %s"

#: includes/class-minn-admin-rest.php:2792
#: includes/class-minn-admin-rest.php:2877
#: includes/class-minn-admin-rest.php:3297
msgid "from must be on or before to."
msgstr "תאריך ההתחלה חייב להיות לפני תאריך הסיום או באותו יום."

#: includes/class-minn-admin-rest.php:2804
