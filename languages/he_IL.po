#: assets/js/app.js:59336
msgid "Restrict content"
msgstr "הגבלת תוכן"

#: assets/js/app.js:59336
msgid "Members of this plan can see the content these rules name; everyone else sees the restricted message. No rules means nothing is restricted."
msgstr "חברי תוכנית זו יכולים לראות את התוכן שכללים אלה מציינים; כל השאר רואים את הודעת ההגבלה. בלי כללים אין דבר מוגבל."

#: assets/js/app.js:59337
msgid "Restrict products"
msgstr "הגבלת מוצרים"

#: assets/js/app.js:59337
msgid "Only members can view or buy the products these rules name."
msgstr "רק חברים יכולים לצפות במוצרים שכללים אלה מציינים או לרכוש אותם."

#: assets/js/app.js:59338
msgid "Members pay less for the products these rules name."
msgstr "חברים משלמים פחות עבור המוצרים שכללים אלה מציינים."

