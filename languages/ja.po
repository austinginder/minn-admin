#. translators: 1: setting name (min, max, step), 2: field name.
#: includes/adapters/acpt.php:1567
msgid "“%1$s” on “%2$s” must be a number."
msgstr "「%2$s」の「%1$s」は数値である必要があります。"

#: includes/adapters/acpt.php:1605
msgid "A submitted field does not exist in this group — reload and try again."
msgstr "送信されたフィールドはこのグループにありません — 再読み込みしてやり直してください。"

