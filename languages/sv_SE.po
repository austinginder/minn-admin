msgstr "Okänd tabell."

#: includes/class-minn-admin-db.php:692
#: includes/class-minn-admin-db.php:720
msgid "Could not read the table structure."
msgstr "Kunde inte läsa tabellstrukturen."

#: includes/class-minn-admin-db.php:751
msgid "That column holds passwords or tokens, so it cannot be searched."
msgstr "Den kolumnen innehåller lösenord eller token, så den kan inte sökas."

#: includes/class-minn-admin-db.php:848
msgid "This table has no usable primary key."
msgstr "Den här tabellen har ingen användbar primärnyckel."

#: includes/class-minn-admin-db.php:858
msgid "Row not found."
msgstr "Raden hittades inte."

#: includes/class-minn-admin-db.php:918
msgid "Not checked"
msgstr "Inte kontrollerad"

#: includes/class-minn-admin-db.php:919
msgid "This table is too large to count cheaply, so Minn does not scan it. Run the command below to check it yourself."
msgstr "Den här tabellen är för stor för att räknas billigt, så Minn skannar den inte. Kör kommandot nedan för att kontrollera den själv."

#: includes/class-minn-admin-db.php:969
msgid "Database hygiene"
msgstr "Databashygien"

#. translators: %s: number of database checks needing attention.
#: includes/class-minn-admin-db.php:975
msgid "%s storage check needs attention"
msgid_plural "%s storage checks need attention"
msgstr[0] "%s lagringskontroll behöver uppmärksamhet"
msgstr[1] "%s lagringskontroller behöver uppmärksamhet"

#: includes/class-minn-admin-db.php:983
msgid "Orphaned rows, indexes and engines all look healthy"
msgstr "Föräldralösa rader, index och motorer ser alla friska ut"

#: includes/class-minn-admin-db.php:1050
msgid "Tables without a primary key"
msgstr "Tabeller utan primärnyckel"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1056
msgid "These tables have no primary key, which breaks row-level replication and confuses backup and migration tools: %s"
msgstr "De här tabellerna har ingen primärnyckel, vilket bryter radnivåreplikering och förvirrar backup- och migreringsverktyg: %s"

#: includes/class-minn-admin-db.php:1059
msgid "Every table has a primary key."
msgstr "Varje tabell har en primärnyckel."

#: includes/class-minn-admin-db.php:1071
msgid "Storage engine"
msgstr "Lagringsmotor"

#. translators: %s: comma-separated list of tables and their storage engines.
#: includes/class-minn-admin-db.php:1077
msgid "These tables do not use InnoDB, so they miss row-level locking and crash recovery: %s"
msgstr "De här tabellerna använder inte InnoDB, så de saknar låsning på radnivå och kraschåterställning: %s"

#: includes/class-minn-admin-db.php:1080
msgid "Every table uses InnoDB."
msgstr "Varje tabell använder InnoDB."

#: includes/class-minn-admin-db.php:1082
msgid "Convert a table"
msgstr "Konvertera en tabell"

#: includes/class-minn-admin-db.php:1084
msgid "Back up first. Converting locks the table while it runs."
msgstr "Säkerhetskopiera först. Konvertering låser tabellen medan den körs."

#: includes/class-minn-admin-db.php:1103
msgid "Reclaimable space"
msgstr "Återvinningsbart utrymme"

#. translators: 1: table name, 2: reclaimable size (e.g. "82.0 MB").
#: includes/class-minn-admin-db.php:1110
msgid "%1$s alone is holding %2$s of free space inside its own file. Optimising rewrites the table and returns it to the disk."
msgstr "%1$s ensam håller %2$s ledigt utrymme i sin egen fil. Optimering skriver om tabellen och lämnar tillbaka det till disken."

#: includes/class-minn-admin-db.php:1114
msgid "No table is holding a significant amount of reclaimable space."
msgstr "Ingen tabell håller en betydande mängd återvinningsbart utrymme."

#: includes/class-minn-admin-db.php:1116
msgid "Optimise tables"
msgstr "Optimera tabeller"

#: includes/class-minn-admin-db.php:1118
msgid "Back up first. Optimising locks each table while it runs."
msgstr "Säkerhetskopiera först. Optimering låser varje tabell medan den körs."

#: includes/class-minn-admin-db.php:1136
msgid "Post meta lookup index"
msgstr "Uppslagsindex för inläggsmeta"

#: includes/class-minn-admin-db.php:1139
msgid "Present"
msgstr "Finns"

#: includes/class-minn-admin-db.php:1141
msgid "A combined post_id and meta_key index is present, so meta lookups stay fast."
msgstr "Ett kombinerat post_id- och meta_key-index finns, så metauppslagningar förblir snabba."

#: includes/class-minn-admin-db.php:1142
msgid "Lookups by post and meta key fall back to two separate indexes. On sites with heavy meta use (WooCommerce, event and booking plugins) a combined index is a large, low-risk speed win."
msgstr "Uppslagningar på inlägg och metanyckel faller tillbaka på två separata index. På webbplatser med tung metaanvändning (WooCommerce, evenemangs- och bokningstillägg) är ett kombinerat index en stor, låg-risk vinst."

#: includes/class-minn-admin-db.php:1144
msgid "Add the index"
msgstr "Lägg till indexet"

#: includes/class-minn-admin-db.php:1146
msgid "Back up first. Adding an index locks the table briefly."
msgstr "Säkerhetskopiera först. Att lägga till ett index låser tabellen kort."

#: includes/class-minn-admin-db.php:1190
msgid "Auto-increment headroom"
msgstr "Auto-increment-utrymme"

#: includes/class-minn-admin-db.php:1192
msgid "Healthy"
msgstr "Friskt"

#. translators: %s: comma-separated list of database table names.
#: includes/class-minn-admin-db.php:1197
msgid "These tables are within 20 percent of the largest id their column type can store. Once the ceiling is reached, new rows stop being written: %s"
msgstr "De här tabellerna är inom 20 procent av det största id deras kolumntyp kan lagra. När taket nås slutar nya rader att skrivas: %s"

#: includes/class-minn-admin-db.php:1200
msgid "No table is close to exhausting its id column."
msgstr "Ingen tabell är nära att tömma sin id-kolumn."

#: includes/class-minn-admin-db.php:1208
msgid "Orphaned post meta"
msgstr "Föräldralös inläggsmeta"

#: includes/class-minn-admin-db.php:1211
msgid "These meta rows belong to posts that no longer exist. They are dead weight in every query that touches post meta."
msgstr "De här metaraderna tillhör inlägg som inte längre finns. De är död vikt i varje fråga som rör inläggsmeta."

#: includes/class-minn-admin-db.php:1212
msgid "Every meta row belongs to a post that still exists."
msgstr "Varje metarad tillhör ett inlägg som fortfarande finns."

#: includes/class-minn-admin-db.php:1214
#: includes/class-minn-admin-db.php:1232
#: includes/class-minn-admin-db.php:1250
msgid "Delete them"
msgstr "Ta bort dem"

#: includes/class-minn-admin-db.php:1216
#: includes/class-minn-admin-db.php:1234
#: includes/class-minn-admin-db.php:1252
msgid "Back up first. This permanently deletes rows."
msgstr "Säkerhetskopiera först. Detta tar bort rader permanent."

#: includes/class-minn-admin-db.php:1226
msgid "Orphaned user meta"
msgstr "Föräldralös användarmeta"

#: includes/class-minn-admin-db.php:1229
msgid "These meta rows belong to users who no longer exist, usually left behind by a plugin that removed accounts directly."
msgstr "De här metaraderna tillhör användare som inte längre finns, oftast kvarlämnade av ett tillägg som tog bort konton direkt."

#: includes/class-minn-admin-db.php:1230
msgid "Every meta row belongs to a user who still exists."
msgstr "Varje metarad tillhör en användare som fortfarande finns."

#: includes/class-minn-admin-db.php:1244
msgid "Orphaned term relationships"
msgstr "Föräldralösa termrelationer"

#: includes/class-minn-admin-db.php:1247
msgid "These rows link content to categories or tags that no longer exist."
msgstr "De här raderna kopplar innehåll till kategorier eller etiketter som inte längre finns."

#: includes/class-minn-admin-db.php:1248
msgid "Every relationship points at a term that still exists."
msgstr "Varje relation pekar på en term som fortfarande finns."

#: includes/class-minn-admin-db.php:1262
msgid "Stored revisions"
msgstr "Lagrade versioner"

#: includes/class-minn-admin-db.php:1265
msgid "Revisions are the editor safety net, so a large number is normal and not a fault. Trimming them is only worthwhile if the posts table has grown unwieldy."
msgstr "Versioner är redigerarens skyddsnät, så ett stort antal är normalt och inte ett fel. Att beskära dem lönar sig bara om inläggstabellen har blivit ohanterlig."

#: includes/class-minn-admin-db.php:1266
msgid "No revisions are stored."
msgstr "Inga versioner är lagrade."

#: includes/class-minn-admin-db.php:1268
msgid "Delete all revisions"
msgstr "Ta bort alla versioner"

#: includes/class-minn-admin-db.php:1270
msgid "Back up first. This removes every saved revision permanently."
msgstr "Säkerhetskopiera först. Detta tar bort varje sparad version permanent."

#: includes/class-minn-admin-db.php:1280
msgid "Spam and trashed comments"
msgstr "Skräppost och kommentarer i papperskorgen"

#: includes/class-minn-admin-db.php:1283
msgid "Spam and trashed comments stay in the database until they are emptied. WordPress clears them on its own after a while."
msgstr "Skräppost och kommentarer i papperskorgen stannar i databasen tills de töms. WordPress rensar dem själv efter ett tag."

#: includes/class-minn-admin-db.php:1284
msgid "No spam or trashed comments are waiting."
msgstr "Inga skräppost- eller papperskorgskommentarer väntar."

#: includes/class-minn-admin-db.php:1286
msgid "Delete spam"
msgstr "Ta bort skräppost"

#: includes/class-minn-admin-db.php:1288
msgid "Back up first. This permanently deletes the comments."
msgstr "Säkerhetskopiera först. Detta tar bort kommentarerna permanent."

#: includes/class-minn-admin-db.php:1299
msgid "Expired WooCommerce sessions"
msgstr "Utgångna WooCommerce-sessioner"

#: includes/class-minn-admin-db.php:1302
msgid "Expired cart sessions should be cleared by a scheduled WooCommerce job. A large backlog usually means that job has stopped running."
msgstr "Utgångna varukorgssessioner ska rensas av ett schemalagt WooCommerce-jobb. En stor eftersläpning betyder oftast att det jobbet har slutat köras."

#: includes/class-minn-admin-db.php:1303
msgid "No expired sessions are left behind."
msgstr "Inga utgångna sessioner är kvarlämnade."

#: includes/class-minn-admin-db.php:1305
msgid "Delete expired sessions"
msgstr "Ta bort utgångna sessioner"

#: includes/class-minn-admin-db.php:1307
msgid "Back up first. Shoppers with an expired cart lose it, which has already happened by definition."
msgstr "Säkerhetskopiera först. Kunder med en utgången varukorg förlorar den, vilket redan har hänt per definition."

#: includes/class-minn-admin-db.php:1318
msgid "Action Scheduler backlog"
msgstr "Action Scheduler-eftersläpning"

#: includes/class-minn-admin-db.php:1321
msgid "Pending and failed background jobs. A steady backlog is normal on a busy store; a very large one suggests the queue is not draining."
msgstr "Väntande och misslyckade bakgrundsjobb. En stadig eftersläpning är normalt i en upptagen butik; en mycket stor tyder på att kön inte töms."

#: includes/class-minn-admin-db.php:1322
msgid "No pending or failed background jobs."
msgstr "Inga väntande eller misslyckade bakgrundsjobb."

#: includes/class-minn-admin-db.php:1324
msgid "Clean the queue"
msgstr "Rensa kön"

#: includes/class-minn-admin-db.php:1326
msgid "Removes finished actions. Pending work is left alone."
msgstr "Tar bort avslutade åtgärder. Väntande arbete lämnas orört."

